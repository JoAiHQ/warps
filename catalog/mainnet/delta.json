        "actions": [
          {
            "type": "collect",
            "label": {
              "en": "Get order"
            },
            "destination": {
              "url": "https://api.joai.ai/v1/orders/{{orderId}}",
              "method": "GET",
              "headers": {
                "X-Agent-Auth-Key": "{{JOAI_AGENT_AUTH_KEY}}",
                "X-Team": "{{team}}",
                "X-Order-Access-Token": "{{orderAccessToken}}"
