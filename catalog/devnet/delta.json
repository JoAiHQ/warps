          {
            "type": "collect",
            "label": {
              "en": "Schedule post",
              "de": "Post planen"
            },
            "destination": {
              "url": "https://devnet-api.joai.ai/v1/social-posts",
              "method": "POST",
              "headers": {
                "X-Agent-Auth-Key": "{{JOAI_AGENT_AUTH_KEY}}",
                "X-Team": "{{team}}"
              }
            },
            "inputs": [
              {
                "name": "Platform",
                "as": "platform",
                "description": {
                  "en": "Network to publish on",
                  "de": "Netzwerk für die Veröffentlichung"
                },
                "type": "string",
                "source": "field",
                "required": true,
                "options": {
                  "instagram": "Instagram"
                },
                "default": "instagram"
              },
              {
                "name": "Caption",
                "as": "body",
                "description": {
                  "en": "Post caption",
                  "de": "Bildunterschrift"
                },
                "type": "string",
                "source": "field",
                "required": false
              },
              {
                "name": "Images",
                "as": "media",
                "description": {
                  "en": "Ordered team media IDs, e.g. [\"abc\",\"def\"]. JPEG only. Upload with media_upload first.",
                  "de": "Team-Medien-IDs in Reihenfolge, z.B. [\"abc\",\"def\"]. Nur JPEG. Zuerst mit media_upload hochladen."
                },
                "bot": "JSON array of media IDs from media_upload, in carousel order.",
                "type": "string",
                "source": "field",
                "required": true
              },
              {
                "name": "Publish at",
                "as": "scheduledAt",
                "description": {
                  "en": "When to publish. ISO time. Without a timezone, the team timezone is used. Omit to save a draft.",
                  "de": "Wann veröffentlicht wird. ISO-Zeit. Ohne Zeitzone gilt die Team-Zeitzone. Weglassen speichert einen Entwurf."
                },
                "type": "string",
                "source": "field",
                "required": false
              },
              {
                "name": "Team",
                "as": "team",
                "description": {
