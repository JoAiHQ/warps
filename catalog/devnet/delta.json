                  "de": "Variantenname"
                },
                "type": "string",
                "source": "field",
                "required": false
              },
              {
                "name": "Active",
                "as": "active",
                "description": {
                  "en": "Whether the variation is active (\"true\"/\"false\")",
                  "de": "Ob die Variante aktiv ist (\"true\"/\"false\")"
                },
                "type": "string",
                "source": "field",
                "required": false
              },
              {
                "name": "Team",
