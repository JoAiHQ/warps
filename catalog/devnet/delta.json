              "it": "Controlla risposta",
              "ro": "Verifică răspunsul"
            },
            "inputs": [
              {
                "name": "correct",
                "type": "boolean",
                "source": "hidden",
                "modifier": "transform:() => { const raw='{{state.competition}}'; if(!raw) return false; const d=JSON.parse(raw); if(!d.active) return false; return '{{JOAI_MESSAGE_TEXT}}'.trim().toLowerCase() === String(d.active.answer).trim().toLowerCase(); }"
              },
              {
                "name": "dataJson",
                "type": "string",
                "source": "hidden",
                "modifier": "transform:() => { const raw='{{state.competition}}'; if(!raw) return ''; const d=JSON.parse(raw); if(!d.active) return raw; const ok='{{JOAI_MESSAGE_TEXT}}'.trim().toLowerCase() === String(d.active.answer).trim().toLowerCase(); if(!ok) return raw; d.active=null; return JSON.stringify(d); }"
              },
              {
                "name": "message",
                "type": "string",
                "source": "hidden",
                "modifier": "transform:() => { const raw='{{state.competition}}'; if(!raw) return ''; const d=JSON.parse(raw); if(!d.active) return ''; const ok='{{JOAI_MESSAGE_TEXT}}'.trim().toLowerCase() === String(d.active.answer).trim().toLowerCase(); return ok ? '🎉 ' + '{{JOAI_SENDER_NAME}}' + ' got it! The answer was ' + d.active.answer + '.' : ''; }"
              }
            ]
          },
          {
            "type": "state",
            "label": {
              "en": "Close competition",
              "de": "Wettbewerb schließen",
              "es": "Cerrar competición",
              "fr": "Clôturer le concours",
              "it": "Chiudi competizione",
              "ro": "Închide competiția"
            },
            "op": "write",
            "store": "boogas-competitions",
            "data": {
              "competition": "{{dataJson}}"
            },
            "when": "{{correct}} === true"
          },
          {
            "type": "unmount",
            "label": {
              "en": "Unmount competition check",
              "de": "Wettbewerbsprüfung deaktivieren",
              "es": "Desactivar comprobación",
              "fr": "Désactiver la vérification",
              "it": "Disattiva verifica",
              "ro": "Dezactivează verificarea"
            },
            "warp": "@boogas-competition-check",
            "when": "{{correct}} === true"
          }
        ],
        "messages": {
          "success": "{{message}}"
        }
