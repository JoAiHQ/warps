                "source": "field",
                "required": true,
                "position": "url:socialPostId"
              },
              {
                "name": "Caption",
                "as": "body",
                "description": {
                  "en": "New caption. Send empty to clear.",
                  "de": "Neue Bildunterschrift. Leer zum Löschen."
                },
                "type": "string",
                "source": "field",
                "required": false
              },
              {
                "name": "Format",
                "as": "format",
                "description": {
                  "en": "Instagram only: feed, short, or story.",
                  "de": "Nur Instagram: feed, short oder story."
                },
                "bot": "Instagram only. feed | short | story.",
                "type": "string",
                "source": "field",
                "required": false,
                "options": {
                  "feed": "Feed",
                  "short": "Short",
                  "story": "Story"
                }
              },
              {
                "name": "Media",
                "as": "media",
                "description": {
                  "en": "Replacement media IDs in order, as a JSON array.",
                  "de": "Ersatz-Medien-IDs in Reihenfolge, als JSON-Array."
                },
                "type": "string",
                "source": "field",
                "required": false
              },
              {
                "name": "Schedule for",
                "as": "scheduledAt",
                "description": {
                  "en": "When JoAi should publish. ISO time. Omit to keep editing without scheduling.",
                  "de": "Wann JoAi veröffentlichen soll. ISO-Zeit. Weglassen, um ohne Planung weiterzubearbeiten."
                },
                "type": "string",
                "source": "field",
                "required": false
              },
              {
                "name": "Team",
                "as": "team",
                "type": "string",
                "source": "field",
                "required": false,
                "default": "{{JOAI_TEAM_SLUG}}"
              }
            ]
          }
        ],
