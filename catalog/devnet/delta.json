              "headers": {
                "X-Agent-Auth-Key": "{{JOAI_AGENT_AUTH_KEY}}",
                "X-Team": "{{team}}"
              }
            },
            "inputs": [
              {
                "name": "Integration",
                "as": "integration",
                "type": "string",
                "position": "payload:integration",
