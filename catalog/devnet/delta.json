            "label": {
              "en": "Save post",
              "de": "Post speichern"
            },
            "destination": {
              "url": "https://devnet-api.joai.ai/v1/social-posts/{{socialPostId}}",
              "method": "PATCH",
              "headers": {
                "X-Agent-Auth-Key": "{{JOAI_AGENT_AUTH_KEY}}",
                "X-Team": "{{team}}"
              }
            },
            "inputs": [
              {
                "name": "Post",
                "as": "socialPostId",
                "description": {
                  "en": "Social post ID",
                  "de": "Social-Post-ID"
