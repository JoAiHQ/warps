                "source": "field",
                "required": false,
                "default": "{{JOAI_TEAM_SLUG}}"
              }
            ],
            "output": {
              "id": "out.data.id",
              "status": "out.data.status",
              "scheduledAt": "out.data.scheduledAt"
            }
          }
        ],
        "messages": {
          "success": {
            "en": "Social post saved ({{status}}).",
            "de": "Social-Post gespeichert ({{status}})."
          }
