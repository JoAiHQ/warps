{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["definition"],
  "additionalProperties": false,
  "properties": {
    "definition": {
      "type": "object",
      "required": ["name", "title", "actions", "messages"],
      "properties": {
        "name": { "type": "string" },
        "title": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        },
        "actions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["type", "label", "inputs"],
            "properties": {
              "type": { "type": "string" },
              "label": {
                "type": "object",
                "additionalProperties": { "type": "string" }
              },
              "inputs": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["name", "type", "source"],
                  "properties": {
                    "name": { "type": "string" },
                    "as": { "type": "string" },
                    "label": {
                      "type": "object",
                      "additionalProperties": { "type": "string" }
                    },
                    "description": {
                      "type": "object",
                      "additionalProperties": { "type": "string" }
                    },
                    "type": { "type": "string" },
                    "source": { "type": "string" },
                    "required": { "type": "boolean" },
                    "options": { "type": ["object", "array"] },
                    "pattern": { "type": "string" },
                    "patternDescription": { "type": ["string", "object"] },
                    "min": { "type": "number" },
                    "max": { "type": "number" },
                    "default": {}
                  }
                }
              }
            }
          }
        },
        "messages": {
          "type": "object",
          "required": ["success"],
          "properties": {
            "success": {
              "type": "object",
              "additionalProperties": { "type": "string" }
            }
          }
        }
      }
    }
  }
}
