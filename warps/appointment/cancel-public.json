{
  "protocol": "warp:3.0.0",
  "name": "Appointments: Cancel (Public)",
  "title": {
    "en": "Cancel appointment",
    "de": "Termin absagen",
    "fr": "Annuler le rendez-vous",
    "es": "Cancelar cita",
    "ro": "Anuleaza programarea",
    "it": "Cancel appointment"
  },
  "description": {
    "en": "Cancel a booked appointment from the public booking widget.",
    "de": "Einen gebuchten Termin über das öffentliche Buchungs-Widget absagen.",
    "fr": "Annulez un rendez-vous depuis le widget de reservation public.",
    "es": "Cancela una cita reservada desde el widget de reserva publico.",
    "ro": "Anuleaza o programare din widgetul public de rezervare.",
    "it": "Cancel a booked appointment from the public booking widget."
  },
  "bot": "Internal warp used by the booking widget to cancel a confirmed appointment. Do not invoke manually.",
  "vars": {
    "JOAI_AGENT_UUID": "env:JOAI_AGENT_UUID"
  },
  "actions": [
    {
      "type": "collect",
      "auto": true,
      "label": {
        "en": "Cancel",
        "de": "Absagen",
        "fr": "Annuler",
        "es": "Cancelar",
        "ro": "Anuleaza",
        "it": "Cancel"
      },
      "destination": {
        "url": "INJECT:API_BASE/v1/agents/{{agentUuid}}/appointments/{{meetingId}}/cancel",
        "method": "POST"
      },
      "inputs": [
        {
          "name": "Meeting ID",
          "as": "meetingId",
          "type": "string",
          "position": "url:meetingId",
          "source": "field",
          "required": true
        },
        {
          "name": "Reason",
          "as": "reason",
          "type": "string",
          "source": "field",
          "required": false
        },
        {
          "name": "Agent UUID",
          "as": "agentUuid",
          "description": {
            "en": "Optional target agent UUID",
            "de": "Optionale UUID des Ziel-Agenten"
          },
          "bot": "Target agent UUID. Omit to use the current agent.",
          "type": "string",
          "source": "field",
          "required": false,
          "default": "{{JOAI_AGENT_UUID}}",
          "position": "url:agentUuid"
        }
      ]
    }
  ],
  "output": {
    "MEETING_ID": "out.data.id",
    "STATUS": "out.data.status",
    "MEETING_TITLE": "out.data.name"
  },
  "messages": {
    "error": {
      "en": "Failed to cancel appointment: {{MESSAGE}}"
    },
    "success": {
      "en": "Appointment cancelled.",
      "de": "Termin abgesagt.",
      "fr": "Rendez-vous annule.",
      "es": "Cita cancelada.",
      "ro": "Programare anulata.",
      "it": "Appointment cancelled."
    }
  }
}
