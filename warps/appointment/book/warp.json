{
  "protocol": "warp:3.0.0",
  "name": "Appointments: Book",
  "title": {
    "en": "Book an Appointment",
    "de": "Termin buchen",
    "es": "Book an Appointment",
    "fr": "Book an Appointment",
    "ro": "Book an Appointment",
    "it": "Book an Appointment"
  },
  "description": {
    "en": "Browse available time slots and book an appointment.",
    "de": "Verfügbare Zeitfenster ansehen und Termin buchen.",
    "es": "Browse available time slots and book an appointment.",
    "fr": "Browse available time slots and book an appointment.",
    "ro": "Browse available time slots and book an appointment.",
    "it": "Browse available time slots and book an appointment."
  },
  "vars": {
    "JOAI_TEAM_SLUG": "env:JOAI_TEAM_SLUG|Team identifier"
  },
  "actions": [
    {
      "type": "collect",
      "auto": true,
      "label": {
        "en": "Load",
        "de": "Laden",
        "es": "Load",
        "fr": "Load",
        "ro": "Load",
        "it": "Load"
      },
      "inputs": [
        {
          "name": "Team",
          "as": "teamSlug",
          "description": {
            "en": "Business team slug",
            "de": "Team-Slug des Unternehmens"
          },
          "bot": "Team slug that owns the appointment policy. For a city business, pass its JoAi team slug (for example flora). Omit to use the current team.",
          "type": "string",
          "source": "field",
          "required": false,
          "default": "{{JOAI_TEAM_SLUG}}",
          "position": "url:teamSlug"
        }
      ],
      "destination": {
        "url": "INJECT:API_BASE/v1/teams/{{teamSlug}}/appointments/policy",
        "method": "GET"
      },
      "output": {
        "policy": "out.data"
      }
    }
  ],
  "messages": {
    "error": {
      "en": "Failed to load appointment configuration: {{MESSAGE}}"
    }
  },
  "ui": "https://raw.githubusercontent.com/JoAiHQ/warps/main/warps/appointment/book/chatapp.715e52d0.dist.html"
}