{
  "protocol": "warp:3.0.0",
  "name": "JoAi: List Automations",
  "title": {
    "en": "List automations",
    "de": "Automationen auflisten",
    "fr": "Lister les automatisations",
    "es": "Listar automatizaciones",
    "it": "Elenca automazioni",
    "ro": "Listează automatizările"
  },
  "description": {
    "en": "List lifecycle automations for the team.",
    "de": "Listet Lifecycle-Automationen des Teams.",
    "fr": "Liste les automatisations de cycle de vie de l'équipe.",
    "es": "Lista las automatizaciones de ciclo de vida del equipo.",
    "it": "Elenca le automazioni di ciclo di vita del team.",
    "ro": "Listează automatizările pe ciclu de viață ale echipei."
  },
  "bot": "Use to inspect drip/automation definitions before update, run, or enrollment checks.",
  "vars": {
    "JOAI_AGENT_UUID": "env:JOAI_AGENT_UUID",
    "JOAI_AGENT_AUTH_KEY": "env:JOAI_AGENT_AUTH_KEY",
    "JOAI_TEAM_SLUG": "env:JOAI_TEAM_SLUG"
  },
  "actions": [
    {
      "type": "collect",
      "auto": true,
      "label": {
        "en": "List automations",
        "de": "Automationen auflisten",
        "fr": "Lister les automatisations",
        "es": "Listar automatizaciones",
        "it": "Elenca automazioni",
        "ro": "Listează automatizările"
      },
      "destination": {
        "url": "INJECT:API_BASE/v1/automations",
        "method": "GET",
        "headers": {
          "X-Agent-Auth-Key": "{{JOAI_AGENT_AUTH_KEY}}",
          "X-Team": "{{team}}"
        }
      },
      "inputs": [
        { "name": "Team", "as": "team", "type": "string", "source": "field", "required": false, "default": "{{JOAI_TEAM_SLUG}}" }
      ]
    }
  ]
}
