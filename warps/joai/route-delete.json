{
  "protocol": "warp:3.0.0",
  "name": "Routes: Delete",
  "title": {
    "en": "Delete route",
    "de": "Route löschen",
    "es": "Eliminar ruta",
    "fr": "Supprimer le parcours",
    "it": "Elimina percorso",
    "ro": "Șterge traseul"
  },
  "description": {
    "en": "Delete a route and its stops.",
    "de": "Löscht eine Route und ihre Stationen.",
    "es": "Elimina una ruta y sus paradas.",
    "fr": "Supprime un parcours et ses étapes.",
    "it": "Elimina un percorso e le sue tappe.",
    "ro": "Șterge un traseu și opririle sale."
  },
  "bot": "Requires team manage permission.",
  "vars": {
    "JOAI_AGENT_AUTH_KEY": "env:JOAI_AGENT_AUTH_KEY",
    "JOAI_TEAM_SLUG": "env:JOAI_TEAM_SLUG"
  },
  "actions": [
    {
      "type": "collect",
      "label": {
        "en": "Delete route",
        "de": "Route löschen",
        "es": "Eliminar ruta",
        "fr": "Supprimer le parcours",
        "it": "Elimina percorso",
        "ro": "Șterge traseul"
      },
      "destination": {
        "url": "INJECT:API_BASE/v1/routes/{{id}}",
        "method": "DELETE",
        "headers": {
          "X-Agent-Auth-Key": "{{JOAI_AGENT_AUTH_KEY}}",
          "Accept": "application/json"
        }
      },
      "inputs": [
        {
          "name": "Route ID",
          "as": "id",
          "type": "string",
          "source": "field",
          "required": true,
          "position": "url:id",
          "description": {
            "en": "Route hashid.",
            "de": "Routen-Hashid.",
            "es": "Hashid de la ruta.",
            "fr": "Hashid du parcours.",
            "it": "Hashid del percorso.",
            "ro": "Hashid-ul traseului."
          }
        }
      ]
    }
  ],
  "messages": {
    "success": {
      "en": "Route deleted.",
      "de": "Route gelöscht.",
      "es": "Ruta eliminada.",
      "fr": "Parcours supprimé.",
      "it": "Percorso eliminato.",
      "ro": "Traseu șters."
    }
  }
}
