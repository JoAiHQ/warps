{
  "protocol": "warp:3.0.0",
  "name": "JoAi: Update Address",
  "title": { "en": "Update address" },
  "description": { "en": "Update a saved shipping or billing address for the authenticated user." },
  "bot": "Use when the user wants to change an existing address. List addresses first to get the address ID.",
  "vars": {
    "JOAI_AGENT_UUID": "env:JOAI_AGENT_UUID",
    "JOAI_AGENT_AUTH_KEY": "env:JOAI_AGENT_AUTH_KEY",
    "JOAI_TEAM_SLUG": "env:JOAI_TEAM_SLUG"
  },
  "actions": [
    {
      "type": "collect",
      "label": { "en": "Update address" },
      "destination": {
        "url": "INJECT:API_BASE/v1/addresses/{{addressId}}",
        "method": "PATCH",
        "headers": {
          "X-Agent-Auth-Key": "{{JOAI_AGENT_AUTH_KEY}}",
          "X-Team": "{{JOAI_TEAM_SLUG}}",
          "Content-Type": "application/json",
          "Accept": "application/json"
        }
      },
      "inputs": [
        {
          "name": "Address ID",
          "as": "addressId",
          "type": "string",
          "position": "url:addressId",
          "source": "field",
          "required": true
        },
        {
          "name": "Name",
          "as": "name",
          "type": "string",
          "source": "field",
          "required": true
        },
        {
          "name": "Country",
          "as": "country",
          "type": "string",
          "source": "field",
          "required": true,
          "bot": "Two-letter ISO country code."
        },
        {
          "name": "Address line 1",
          "as": "addressOne",
          "type": "string",
          "source": "field",
          "required": false
        },
        {
          "name": "City",
          "as": "city",
          "type": "string",
          "source": "field",
          "required": false
        },
        {
          "name": "Zip code",
          "as": "zipCode",
          "type": "string",
          "source": "field",
          "required": false
        },
        {
          "name": "Type",
          "as": "type",
          "type": "string",
          "source": "field",
          "required": false,
          "bot": "billing or shipping"
        }
      ]
    }
  ],
  "messages": {
    "success": { "en": "Address updated." },
    "error": { "en": "Failed to update address: {{MESSAGE}}" }
  }
}
