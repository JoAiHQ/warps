{
  "protocol": "warp:3.0.0",
  "name": "JoAi: Get Order",
  "title": {
    "en": "Get order"
  },
  "description": {
    "en": "Fetch order details by ID. Guest access requires the X-Order-Access-Token from checkout."
  },
  "bot": "Use when the user wants order details. For guest orders, pass the access token returned at checkout. Team managers also receive deliveryNoteUrl and shippingLabelUrl (signed PDF links) for packing.",
  "vars": {
    "JOAI_AGENT_UUID": "env:JOAI_AGENT_UUID",
    "JOAI_AGENT_AUTH_KEY": "env:JOAI_AGENT_AUTH_KEY",
    "JOAI_TEAM_SLUG": "env:JOAI_TEAM_SLUG"
  },
  "actions": [
    {
      "type": "collect",
      "label": {
        "en": "Get order"
      },
      "destination": {
        "url": "INJECT:API_BASE/v1/orders/{{orderId}}",
        "method": "GET",
        "headers": {
          "X-Agent-Auth-Key": "{{JOAI_AGENT_AUTH_KEY}}",
          "X-Team": "{{team}}",
          "X-Order-Access-Token": "{{orderAccessToken}}"
        }
      },
      "inputs": [
        {
          "name": "Order ID",
          "as": "orderId",
          "description": {
            "en": "The hashid of the order"
          },
          "bot": "The order hash ID. List orders first if the user refers to an order by customer or item.",
          "type": "string",
          "position": "url:orderId",
          "source": "field",
          "required": true
        },
        {
          "name": "Order Access Token",
          "as": "orderAccessToken",
          "description": {
            "en": "Guest access token for the order"
          },
          "bot": "Optional. Required for guest checkout orders — use the orderAccessToken from place-order.",
          "type": "string",
          "source": "field",
          "position": "header:X-Order-Access-Token",
          "required": false
        },
        {
          "name": "Team",
          "as": "team",
          "description": {
            "en": "Team slug for this action. Defaults to the current team."
          },
          "bot": "The slug of the team to operate on. Omit to use the current team.",
          "type": "string",
          "source": "field",
          "required": false,
          "default": "{{JOAI_TEAM_SLUG}}"
        }
      ],
      "output": {
        "id": "out.data.id",
        "status": "out.data.status",
        "total": "out.data.total",
        "paymentUrl": "out.data.paymentUrl",
        "invoiceUrl": "out.data.invoiceUrl",
        "deliveryNoteUrl": "out.data.deliveryNoteUrl",
        "shippingLabelUrl": "out.data.shippingLabelUrl",
        "fulfillmentMethod": "out.data.fulfillmentMethod",
        "invoiceDate": "out.data.invoiceDate",
        "serviceDate": "out.data.serviceDate",
        "invoiceContactId": "out.data.invoiceContactId",
        "invoiceContactName": "out.data.invoiceContact.name",
        "invoiceContactEmail": "out.data.invoiceContact.email"
      }
    }
  ],
  "output": {
    "ORDER_ID": "out.data.id",
    "ORDER_STATUS": "out.data.status",
    "ORDER_TOTAL": "out.data.total",
    "PAYMENT_URL": "out.data.paymentUrl",
    "INVOICE_URL": "out.data.invoiceUrl",
    "DELIVERY_NOTE_URL": "out.data.deliveryNoteUrl",
    "SHIPPING_LABEL_URL": "out.data.shippingLabelUrl",
    "FULFILLMENT_METHOD": "out.data.fulfillmentMethod",
    "INVOICE_DATE": "out.data.invoiceDate",
    "SERVICE_DATE": "out.data.serviceDate",
    "INVOICE_CONTACT_ID": "out.data.invoiceContactId",
    "INVOICE_CONTACT_NAME": "out.data.invoiceContact.name",
    "INVOICE_CONTACT_EMAIL": "out.data.invoiceContact.email"
  },
  "messages": {
    "success": {
      "en": "Order {{ORDER_ID}} — status: {{ORDER_STATUS}}."
    },
    "error": {
      "en": "Failed to get order: {{MESSAGE}}"
    }
  }
}
