{
  "protocol": "warp:3.0.0",
  "name": "JoAi: Create Product",
  "title": {
    "en": "Create a product",
    "de": "Produkt erstellen"
  },
  "description": {
    "en": "Price in cents for the base product. For variations, set each variation's price in the input below.",
    "de": "Preis in Cent für das Basisprodukt. Bei Varianten den Preis jeder Variante unten eingeben."
  },
  "bot": "Use when the user wants to create a new product, material, or billable item with multiple variations/pricing tiers. Extract name, price, and variation names/SKUs/prices from their description. For example: '10 pieces at €4, 50 pieces at €3' becomes variations with different SKUs.",
  "vars": {
    "JOAI_AGENT_UUID": "env:JOAI_AGENT_UUID",
    "JOAI_AGENT_AUTH_KEY": "env:JOAI_AGENT_AUTH_KEY",
    "JOAI_TEAM_SLUG": "env:JOAI_TEAM_SLUG"
  },
  "actions": [
    {
      "type": "collect",
      "label": {
        "en": "Create product",
        "de": "Produkt erstellen"
      },
      "destination": {
        "url": "INJECT:API_BASE/v1/products",
        "method": "POST",
        "headers": {
          "X-Agent-Auth-Key": "{{JOAI_AGENT_AUTH_KEY}}",
          "X-Team": "{{team}}"
        }
      },
      "inputs": [
        {
          "name": "Name",
          "as": "name",
          "description": {
            "en": "Product name",
            "de": "Produktname"
          },
          "type": "string",
          "source": "field",
          "required": true
        },
        {
          "name": "Price",
          "as": "price",
          "description": {
            "en": "Price in cents",
            "de": "Preis in Cent"
          },
          "type": "number",
          "source": "field",
          "required": true
        },
        {
          "name": "Unit",
          "as": "unit",
          "description": {
            "en": "Unit (e.g. Stück, kg, h)",
            "de": "Einheit (z.B. Stück, kg, h)"
          },
          "type": "string",
          "source": "field",
          "required": false
        },
        {
          "name": "Tags",
          "as": "tags",
          "description": {
            "en": "Tags as array, e.g. [\"appetizers\",\"mains\"]",
            "de": "Tags als Array, z.B. [\"vorspeisen\",\"hauptgerichte\"]"
          },
          "type": "json",
          "source": "field",
          "required": false
        },
        {
          "name": "Description",
          "as": "description",
          "description": {
            "en": "Product description",
            "de": "Produktbeschreibung"
          },
          "type": "string",
          "source": "field",
          "required": false
        },
        {
          "name": "Public",
          "as": "public",
          "description": {
            "en": "Whether the product is publicly visible (\"true\"/\"false\")",
            "de": "Ob das Produkt öffentlich sichtbar ist (\"true\"/\"false\")"
          },
          "type": "string",
          "source": "field",
          "required": false
        },
        {
          "name": "Team",
          "as": "team",
          "description": {
            "en": "Team slug to create the product for. Defaults to the current team.",
            "de": "Team-Slug, für das das Produkt erstellt wird. Standardmäßig das aktuelle Team."
          },
          "bot": "The slug of the team the product belongs to. Omit to use the current team.",
          "type": "string",
          "source": "field",
          "required": false,
          "default": "{{JOAI_TEAM_SLUG}}"
        }
      ]
    }
  ],
  "output": {
    "id": "out.data.id",
    "name": "out.data.name"
  },
  "messages": {
    "success": {
      "en": "Product created: {{name}}",
      "de": "Produkt erstellt: {{name}}",
      "fr": "Produit créé : {{name}}",
      "es": "Producto creado: {{name}}",
      "it": "Prodotto creato: {{name}}",
      "ro": "Produs creat: {{name}}"
    },
    "error": {
      "en": "Failed to create product: {{MESSAGE}}",
      "de": "Produkt konnte nicht erstellt werden: {{MESSAGE}}"
    }
  }
}
