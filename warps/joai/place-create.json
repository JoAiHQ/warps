{
  "protocol": "warp:3.0.0",
  "name": "Places: Create",
  "title": {
    "en": "Create place",
    "de": "Ort erstellen",
    "es": "Crear lugar",
    "fr": "Créer un lieu",
    "ro": "Creează loc",
    "it": "Crea luogo"
  },
  "description": {
    "en": "Create a map pin for the team: a sight, business, playground, viewpoint or other point of interest. Tagline and description are stored in the team locale.",
    "de": "Erstellt einen Kartenpunkt für das Team: Sehenswürdigkeit, Betrieb, Spielplatz, Aussichtspunkt oder ein anderer Ort von Interesse. Kurzbeschreibung und Beschreibung werden in der Team-Sprache gespeichert.",
    "es": "Crea un punto en el mapa para el equipo: monumento, negocio, parque, mirador u otro lugar de interés. La frase y la descripción se guardan en el idioma del equipo.",
    "fr": "Crée un point sur la carte pour l’équipe : site, commerce, aire de jeux, point de vue ou autre lieu d’intérêt. L’accroche et la description sont enregistrées dans la langue de l’équipe.",
    "ro": "Creează un punct pe hartă pentru echipă: obiectiv, afacere, loc de joacă, belvedere sau alt loc de interes. Sloganul și descrierea sunt salvate în limba echipei.",
    "it": "Crea un punto sulla mappa per il team: attrazione, attività, parco giochi, punto panoramico o altro luogo di interesse. Tagline e descrizione vengono salvati nella lingua del team."
  },
  "bot": "Requires team manage permission. Use a stable slug; it is unique within the team.",
  "vars": {
    "JOAI_AGENT_AUTH_KEY": "env:JOAI_AGENT_AUTH_KEY",
    "JOAI_TEAM_SLUG": "env:JOAI_TEAM_SLUG"
  },
  "actions": [
    {
      "type": "collect",
      "label": {
        "en": "Create place",
        "de": "Ort erstellen",
        "es": "Crear lugar",
        "fr": "Créer un lieu",
        "ro": "Creează loc",
        "it": "Crea luogo"
      },
      "destination": {
        "url": "INJECT:API_BASE/v1/places",
        "method": "POST",
        "headers": {
          "X-Agent-Auth-Key": "{{JOAI_AGENT_AUTH_KEY}}",
          "Accept": "application/json"
        }
      },
      "inputs": [
        {
          "name": "Team",
          "as": "team",
          "type": "string",
          "source": "field",
          "required": false,
          "default": "{{JOAI_TEAM_SLUG}}",
          "description": {
            "en": "Team slug that owns the place.",
            "de": "Team-Slug, dem der Ort gehört."
          }
        },
        {
          "name": "Slug",
          "as": "slug",
          "type": "string",
          "source": "field",
          "required": true,
          "description": {
            "en": "Stable URL slug, unique within the team.",
            "de": "Stabiler URL-Slug, eindeutig im Team."
          }
        },
        {
          "name": "Name",
          "as": "name",
          "type": "string",
          "source": "field",
          "required": true,
          "description": {
            "en": "Display name.",
            "de": "Anzeigename."
          }
        },
        {
          "name": "Tagline",
          "as": "tagline",
          "type": "string",
          "source": "field",
          "required": false,
          "description": {
            "en": "Short one-line summary.",
            "de": "Kurze einzeilige Zusammenfassung."
          }
        },
        {
          "name": "Description",
          "as": "description",
          "type": "string",
          "source": "field",
          "required": false,
          "description": {
            "en": "Longer description for the place page.",
            "de": "Längere Beschreibung für die Ort-Seite."
          }
        },
        {
          "name": "Latitude",
          "as": "lat",
          "type": "number",
          "source": "field",
          "required": true,
          "description": {
            "en": "Latitude.",
            "de": "Breitengrad."
          }
        },
        {
          "name": "Longitude",
          "as": "lng",
          "type": "number",
          "source": "field",
          "required": true,
          "description": {
            "en": "Longitude.",
            "de": "Längengrad."
          }
        },
        {
          "name": "Altitude",
          "as": "altitudeM",
          "type": "number",
          "source": "field",
          "required": false,
          "description": {
            "en": "Altitude in metres.",
            "de": "Höhe in Metern."
          }
        },
        {
          "name": "Address",
          "as": "address",
          "type": "string",
          "source": "field",
          "required": false,
          "description": {
            "en": "Street and number.",
            "de": "Straße und Hausnummer."
          }
        },
        {
          "name": "Postal code",
          "as": "postalCode",
          "type": "string",
          "source": "field",
          "required": false,
          "description": {
            "en": "Postal code.",
            "de": "Postleitzahl."
          }
        },
        {
          "name": "City",
          "as": "city",
          "type": "string",
          "source": "field",
          "required": false,
          "description": {
            "en": "City.",
            "de": "Stadt."
          }
        },
        {
          "name": "Country",
          "as": "country",
          "type": "string",
          "source": "field",
          "required": false,
          "description": {
            "en": "ISO 3166-1 alpha-2 country code.",
            "de": "ISO-3166-1-alpha-2-Ländercode."
          }
        },
        {
          "name": "Timezone",
          "as": "timezone",
          "type": "string",
          "source": "field",
          "required": false,
          "description": {
            "en": "IANA timezone.",
            "de": "IANA-Zeitzone."
          }
        },
        {
          "name": "Category",
          "as": "category",
          "type": "string",
          "source": "field",
          "required": false,
          "description": {
            "en": "Optional category, e.g. sight or cafe.",
            "de": "Optionale Kategorie, z. B. Sehenswürdigkeit oder Café."
          }
        },
        {
          "name": "Tags",
          "as": "tags",
          "type": "json",
          "source": "field",
          "required": false,
          "description": {
            "en": "JSON array of tags, e.g. [\"poi\",\"viewpoint\"].",
            "de": "JSON-Array von Tags, z. B. [\"poi\",\"viewpoint\"]."
          }
        },
        {
          "name": "Website",
          "as": "website",
          "type": "string",
          "source": "field",
          "required": false,
          "description": {
            "en": "Website URL.",
            "de": "Website-URL."
          }
        },
        {
          "name": "Phone",
          "as": "phone",
          "type": "string",
          "source": "field",
          "required": false,
          "description": {
            "en": "Phone number.",
            "de": "Telefonnummer."
          }
        },
        {
          "name": "Opening hours",
          "as": "openingHours",
          "type": "json",
          "source": "field",
          "required": false,
          "description": {
            "en": "Opening hours as a JSON value.",
            "de": "Öffnungszeiten als JSON-Wert."
          }
        },
        {
          "name": "Meta",
          "as": "meta",
          "type": "json",
          "source": "field",
          "required": false,
          "description": {
            "en": "Additional JSON metadata.",
            "de": "Zusätzliche JSON-Metadaten."
          }
        },
        {
          "name": "Public",
          "as": "public",
          "type": "boolean",
          "source": "field",
          "required": false,
          "default": true,
          "description": {
            "en": "Whether the place is publicly visible.",
            "de": "Ob der Ort öffentlich sichtbar ist."
          }
        },
        {
          "name": "Published at",
          "as": "publishedAt",
          "type": "string",
          "source": "field",
          "required": false,
          "description": {
            "en": "ISO 8601 publication time; omit to publish now.",
            "de": "ISO-8601-Veröffentlichungszeit; weglassen, um sofort zu veröffentlichen."
          }
        },
        {
          "name": "Cover media",
          "as": "cover",
          "type": "json",
          "source": "field",
          "required": false,
          "description": {
            "en": "JSON array with one team media hashid for the cover image (upload with media_upload first).",
            "de": "JSON-Array mit einem Team-Medien-Hashid für das Titelbild (zuerst mit media_upload hochladen)."
          }
        },
        {
          "name": "Gallery media",
          "as": "gallery",
          "type": "json",
          "source": "field",
          "required": false,
          "description": {
            "en": "JSON array of team media hashids for gallery photos.",
            "de": "JSON-Array von Team-Medien-Hashids für Galerie-Fotos."
          }
        },
        {
          "name": "Audio media",
          "as": "audio",
          "type": "json",
          "source": "field",
          "required": false,
          "description": {
            "en": "JSON array of team media hashids for audio guides.",
            "de": "JSON-Array von Team-Medien-Hashids für Audio-Guides."
          }
        },
        {
          "name": "Model media",
          "as": "models",
          "type": "json",
          "source": "field",
          "required": false,
          "description": {
            "en": "JSON array of team media hashids for 3D model assets.",
            "de": "JSON-Array von Team-Medien-Hashids für 3D-Modell-Dateien."
          }
        }
      ],
      "output": {
        "id": "out.data.id",
        "slug": "out.data.slug",
        "name": "out.data.name"
      }
    }
  ],
  "output": {
    "PLACE_ID": "out.data.id",
    "PLACE_SLUG": "out.data.slug",
    "PLACE_NAME": "out.data.name"
  },
  "messages": {
    "success": {
      "en": "Place '{{PLACE_NAME}}' created.",
      "de": "Ort '{{PLACE_NAME}}' erstellt.",
      "es": "Lugar '{{PLACE_NAME}}' creado.",
      "fr": "Lieu '{{PLACE_NAME}}' créé.",
      "ro": "Locul '{{PLACE_NAME}}' a fost creat.",
      "it": "Luogo '{{PLACE_NAME}}' creato."
    }
  }
}
