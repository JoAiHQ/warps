{
  "protocol": "warp:3.0.0",
  "name": "Routes: Add Stop",
  "title": {
    "en": "Add route stop",
    "de": "Station hinzufügen",
    "es": "Añadir parada",
    "fr": "Ajouter une étape",
    "it": "Aggiungi tappa",
    "ro": "Adaugă oprire"
  },
  "description": {
    "en": "Append a place to a route. The place must belong to the same team.",
    "de": "Hängt einen Ort als Station an eine Route an. Der Ort muss zum selben Team gehören.",
    "es": "Añade un lugar como parada al final de una ruta. El lugar debe pertenecer al mismo equipo.",
    "fr": "Ajoute un lieu comme étape à la fin d’un parcours. Le lieu doit appartenir à la même équipe.",
    "it": "Aggiunge un luogo come tappa in fondo a un percorso. Il luogo deve appartenere allo stesso team.",
    "ro": "Adaugă un loc ca oprire la finalul unui traseu. Locul trebuie să aparțină aceleiași echipe."
  },
  "bot": "Place must belong to the same team.",
  "vars": {
    "JOAI_AGENT_AUTH_KEY": "env:JOAI_AGENT_AUTH_KEY",
    "JOAI_TEAM_SLUG": "env:JOAI_TEAM_SLUG"
  },
  "actions": [
    {
      "type": "collect",
      "label": {
        "en": "Add route stop",
        "de": "Station hinzufügen",
        "es": "Añadir parada",
        "fr": "Ajouter une étape",
        "it": "Aggiungi tappa",
        "ro": "Adaugă oprire"
      },
      "destination": {
        "url": "INJECT:API_BASE/v1/routes/{{id}}/stops",
        "method": "POST",
        "headers": {
          "X-Agent-Auth-Key": "{{JOAI_AGENT_AUTH_KEY}}",
          "Accept": "application/json"
        }
      },
      "inputs": [
        {
          "name": "Route ID",
          "as": "id",
          "type": "string",
          "source": "field",
          "required": true,
          "position": "url:id",
          "description": {
            "en": "Route hashid.",
            "de": "Routen-Hashid.",
            "es": "Hashid de la ruta.",
            "fr": "Hashid du parcours.",
            "it": "Hashid del percorso.",
            "ro": "Hashid-ul traseului."
          }
        },
        {
          "name": "Place ID",
          "as": "placeId",
          "type": "string",
          "source": "field",
          "required": true,
          "description": {
            "en": "Place hashid.",
            "de": "Orts-Hashid.",
            "es": "Hashid del lugar.",
            "fr": "Hashid du lieu.",
            "it": "Hashid del luogo.",
            "ro": "Hashid-ul locului."
          }
        },
        {
          "name": "Day",
          "as": "day",
          "type": "number",
          "source": "field",
          "required": false,
          "description": {
            "en": "Day number.",
            "de": "Tagesnummer.",
            "es": "Número de día.",
            "fr": "Numéro de jour.",
            "it": "Numero del giorno.",
            "ro": "Numărul zilei."
          }
        },
        {
          "name": "Duration minutes",
          "as": "durationMinutes",
          "type": "number",
          "source": "field",
          "required": false,
          "description": {
            "en": "Stop duration in minutes.",
            "de": "Dauer der Station in Minuten.",
            "es": "Duración de la parada en minutos.",
            "fr": "Durée de l’étape en minutes.",
            "it": "Durata della tappa in minuti.",
            "ro": "Durata opririi în minute."
          }
        },
        {
          "name": "Leg mode",
          "as": "legMode",
          "type": "string",
          "source": "field",
          "required": false,
          "description": {
            "en": "walk, bike, car or transit.",
            "de": "Zu Fuß, Rad, Auto oder Öffis.",
            "es": "a pie, bici, coche o transporte público.",
            "fr": "à pied, vélo, voiture ou transport en commun.",
            "it": "a piedi, bici, auto o mezzi pubblici.",
            "ro": "pe jos, bicicletă, mașină sau transport public."
          }
        },
        {
          "name": "Notes",
          "as": "notes",
          "type": "string",
          "source": "field",
          "required": false,
          "description": {
            "en": "Stop notes.",
            "de": "Notizen zur Station.",
            "es": "Notas de la parada.",
            "fr": "Notes de l’étape.",
            "it": "Note della tappa.",
            "ro": "Notele opririi."
          }
        },
        {
          "name": "Meta",
          "as": "meta",
          "type": "json",
          "source": "field",
          "required": false,
          "description": {
            "en": "JSON metadata.",
            "de": "JSON-Metadaten.",
            "es": "Metadatos JSON.",
            "fr": "Métadonnées JSON.",
            "it": "Metadati JSON.",
            "ro": "Metadate JSON."
          }
        }
      ],
      "output": {
        "id": "out.data.id",
        "position": "out.data.position"
      }
    }
  ],
  "output": {
    "STOP_ID": "out.data.id",
    "STOP_POSITION": "out.data.position"
  },
  "messages": {
    "success": {
      "en": "Stop added.",
      "de": "Station hinzugefügt.",
      "es": "Parada añadida.",
      "fr": "Étape ajoutée.",
      "it": "Tappa aggiunta.",
      "ro": "Oprire adăugată."
    }
  }
}
