{
  "protocol": "warp:3.0.0",
  "name": "JoAi: Delete Address",
  "title": { "en": "Delete address" },
  "description": { "en": "Delete a saved address for the authenticated user." },
  "bot": "Use when the user wants to remove an address. List addresses first to get the address ID.",
  "vars": {
    "JOAI_API_TOKEN": "env:JOAI_API_TOKEN"
  },
  "actions": [
    {
      "type": "collect",
      "label": { "en": "Delete address" },
      "destination": {
        "url": "INJECT:API_BASE/v1/addresses/{{addressId}}",
        "method": "DELETE",
        "headers": {
          "Authorization": "Bearer {{JOAI_API_TOKEN}}",
          "Content-Type": "application/json",
          "Accept": "application/json"
        }
      },
      "inputs": [
        {
          "name": "Address ID",
          "as": "addressId",
          "type": "string",
          "position": "url:addressId",
          "source": "field",
          "required": true
        }
      ]
    }
  ],
  "messages": {
    "success": { "en": "Address deleted." },
    "error": { "en": "Failed to delete address: {{MESSAGE}}" }
  }
}
