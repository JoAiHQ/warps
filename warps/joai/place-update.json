{
  "protocol": "warp:3.0.0",
  "name": "Places: Update",
  "title": {
    "en": "Update place",
    "de": "Ort aktualisieren",
    "es": "Actualizar lugar",
    "fr": "Mettre à jour le lieu",
    "ro": "Actualizează locul",
    "it": "Aggiorna luogo"
  },
  "description": {
    "en": "Update a place by its hashid. Send only the fields that change. Set public to false to hide it, or move publishedAt to schedule it.",
    "de": "Aktualisiert einen Ort per Hashid. Sende nur die Felder, die sich ändern. Setze public auf false, um ihn auszublenden, oder verschiebe publishedAt, um ihn zu planen.",
    "es": "Actualiza un lugar por su hashid. Envía solo los campos que cambian. Pon public en false para ocultarlo o mueve publishedAt para programarlo.",
    "fr": "Met à jour un lieu par son hashid. N’envoyez que les champs modifiés. Passez public à false pour le masquer ou déplacez publishedAt pour le programmer.",
    "ro": "Actualizează un loc după hashid. Trimite doar câmpurile modificate. Setează public la false pentru a-l ascunde sau mută publishedAt pentru a-l programa.",
    "it": "Aggiorna un luogo tramite hashid. Invia solo i campi modificati. Imposta public su false per nasconderlo o sposta publishedAt per programmarlo."
  },
  "bot": "Requires team manage permission. Get the hashid from list_places. Only send changed fields.",
  "vars": {
    "JOAI_AGENT_AUTH_KEY": "env:JOAI_AGENT_AUTH_KEY",
    "JOAI_TEAM_SLUG": "env:JOAI_TEAM_SLUG"
  },
  "actions": [
    {
      "type": "collect",
      "label": {
        "en": "Update place",
        "de": "Ort aktualisieren",
        "es": "Actualizar lugar",
        "fr": "Mettre à jour le lieu",
        "ro": "Actualizează locul",
        "it": "Aggiorna luogo"
      },
      "destination": {
        "url": "INJECT:API_BASE/v1/places/{{id}}",
        "method": "PATCH",
        "headers": {
          "X-Agent-Auth-Key": "{{JOAI_AGENT_AUTH_KEY}}",
          "Accept": "application/json"
        }
      },
      "inputs": [
        {
          "name": "Place ID",
          "as": "id",
          "type": "string",
          "source": "field",
          "required": true,
          "position": "url:id",
          "description": {
            "en": "Place hashid from list_places.",
            "de": "Ort-Hashid aus list_places.",
            "es": "Hashid del lugar de list_places.",
            "fr": "Hashid du lieu depuis list_places.",
            "ro": "Hashid-ul locului din list_places.",
            "it": "Hashid del luogo da list_places."
          }
        },
        {
          "name": "Slug",
          "as": "slug",
          "type": "string",
          "source": "field",
          "required": false,
          "description": {
            "en": "Stable URL slug, unique within the team.",
            "de": "Stabiler URL-Slug, eindeutig im Team."
          }
        },
        {
          "name": "Name",
          "as": "name",
          "type": "string",
          "source": "field",
          "required": false,
          "description": {
            "en": "Display name.",
            "de": "Anzeigename."
          }
        },
        {
          "name": "Tagline",
          "as": "tagline",
          "type": "string",
          "source": "field",
          "required": false,
          "description": {
            "en": "Short one-line summary.",
            "de": "Kurze einzeilige Zusammenfassung."
          }
        },
        {
          "name": "Description",
          "as": "description",
          "type": "string",
          "source": "field",
          "required": false,
          "description": {
            "en": "Longer description for the place page.",
            "de": "Längere Beschreibung für die Ort-Seite."
          }
        },
        {
          "name": "Latitude",
          "as": "lat",
          "type": "number",
          "source": "field",
          "required": false,
          "description": {
            "en": "Latitude.",
            "de": "Breitengrad."
          }
        },
        {
          "name": "Longitude",
          "as": "lng",
          "type": "number",
          "source": "field",
          "required": false,
          "description": {
            "en": "Longitude.",
            "de": "Längengrad."
          }
        },
        {
          "name": "Altitude",
          "as": "altitudeM",
          "type": "number",
          "source": "field",
          "required": false,
          "description": {
            "en": "Altitude in metres.",
            "de": "Höhe in Metern."
          }
        },
        {
          "name": "Address",
          "as": "address",
          "type": "string",
          "source": "field",
          "required": false,
          "description": {
            "en": "Street and number.",
            "de": "Straße und Hausnummer."
          }
        },
        {
          "name": "Postal code",
          "as": "postalCode",
          "type": "string",
          "source": "field",
          "required": false,
          "description": {
            "en": "Postal code.",
            "de": "Postleitzahl."
          }
        },
        {
          "name": "City",
          "as": "city",
          "type": "string",
          "source": "field",
          "required": false,
          "description": {
            "en": "City.",
            "de": "Stadt."
          }
        },
        {
          "name": "Country",
          "as": "country",
          "type": "string",
          "source": "field",
          "required": false,
          "description": {
            "en": "ISO 3166-1 alpha-2 country code.",
            "de": "ISO-3166-1-alpha-2-Ländercode."
          }
        },
        {
          "name": "Timezone",
          "as": "timezone",
          "type": "string",
          "source": "field",
          "required": false,
          "description": {
            "en": "IANA timezone.",
            "de": "IANA-Zeitzone."
          }
        },
        {
          "name": "Category",
          "as": "category",
          "type": "string",
          "source": "field",
          "required": false,
          "description": {
            "en": "Optional category, e.g. sight or cafe.",
            "de": "Optionale Kategorie, z. B. Sehenswürdigkeit oder Café."
          }
        },
        {
          "name": "Tags",
          "as": "tags",
          "type": "json",
          "source": "field",
          "required": false,
          "description": {
            "en": "JSON array of tags, e.g. [\"poi\",\"viewpoint\"].",
            "de": "JSON-Array von Tags, z. B. [\"poi\",\"viewpoint\"]."
          }
        },
        {
          "name": "Website",
          "as": "website",
          "type": "string",
          "source": "field",
          "required": false,
          "description": {
            "en": "Website URL.",
            "de": "Website-URL."
          }
        },
        {
          "name": "Phone",
          "as": "phone",
          "type": "string",
          "source": "field",
          "required": false,
          "description": {
            "en": "Phone number.",
            "de": "Telefonnummer."
          }
        },
        {
          "name": "Opening hours",
          "as": "openingHours",
          "type": "json",
          "source": "field",
          "required": false,
          "description": {
            "en": "Opening hours as a JSON value.",
            "de": "Öffnungszeiten als JSON-Wert."
          }
        },
        {
          "name": "Meta",
          "as": "meta",
          "type": "json",
          "source": "field",
          "required": false,
          "description": {
            "en": "Additional JSON metadata.",
            "de": "Zusätzliche JSON-Metadaten."
          }
        },
        {
          "name": "Public",
          "as": "public",
          "type": "boolean",
          "source": "field",
          "required": false,
          "default": true,
          "description": {
            "en": "Whether the place is publicly visible.",
            "de": "Ob der Ort öffentlich sichtbar ist."
          }
        },
        {
          "name": "Published at",
          "as": "publishedAt",
          "type": "string",
          "source": "field",
          "required": false,
          "description": {
            "en": "ISO 8601 publication time; omit to publish now.",
            "de": "ISO-8601-Veröffentlichungszeit; weglassen, um sofort zu veröffentlichen."
          }
        },
        {
          "name": "Cover media",
          "as": "cover",
          "type": "json",
          "source": "field",
          "required": false,
          "description": {
            "en": "Replacement JSON array with one team media hashid; an empty array clears it (upload with media_upload first).",
            "de": "Ersetzendes JSON-Array mit einem Team-Medien-Hashid; ein leeres Array leert es (zuerst mit media_upload hochladen)."
          }
        },
        {
          "name": "Gallery media",
          "as": "gallery",
          "type": "json",
          "source": "field",
          "required": false,
          "description": {
            "en": "Replacement JSON array of team media hashids for gallery photos.",
            "de": "Ersetzendes JSON-Array von Team-Medien-Hashids für Galerie-Fotos."
          }
        },
        {
          "name": "Audio media",
          "as": "audio",
          "type": "json",
          "source": "field",
          "required": false,
          "description": {
            "en": "Replacement JSON array of team media hashids for audio guides.",
            "de": "Ersetzendes JSON-Array von Team-Medien-Hashids für Audio-Guides."
          }
        },
        {
          "name": "Model media",
          "as": "models",
          "type": "json",
          "source": "field",
          "required": false,
          "description": {
            "en": "Replacement JSON array of team media hashids for 3D model assets.",
            "de": "Ersetzendes JSON-Array von Team-Medien-Hashids für 3D-Modell-Dateien."
          }
        }
      ],
      "output": {
        "id": "out.data.id",
        "slug": "out.data.slug",
        "name": "out.data.name"
      }
    }
  ],
  "output": {
    "PLACE_ID": "out.data.id",
    "PLACE_SLUG": "out.data.slug",
    "PLACE_NAME": "out.data.name"
  },
  "messages": {
    "success": {
      "en": "Place updated.",
      "de": "Ort aktualisiert.",
      "es": "Lugar actualizado.",
      "fr": "Lieu mis à jour.",
      "ro": "Loc actualizat.",
      "it": "Luogo aggiornato."
    }
  }
}
