{
  "protocol": "warp:3.0.0",
  "name": "JoAi: List Addresses",
  "title": {
    "en": "List addresses"
  },
  "description": {
    "en": "List saved addresses for the authenticated user. Optionally filter by type (billing or shipping)."
  },
  "bot": "Use when the user wants to see their saved billing or shipping addresses.",
  "vars": {
    "JOAI_API_TOKEN": "env:JOAI_API_TOKEN|Admin Sanctum API token"
  },
  "actions": [
    {
      "type": "collect",
      "auto": true,
      "label": {
        "en": "List addresses"
      },
      "destination": {
        "url": "INJECT:API_BASE/v1/addresses",
        "method": "GET",
        "headers": {
          "Authorization": "Bearer {{JOAI_API_TOKEN}}",
          "Accept": "application/json"
        }
      },
      "inputs": [
        {
          "name": "Type",
          "as": "type",
          "description": {
            "en": "Filter by address type: billing or shipping"
          },
          "bot": "Optional. Pass billing or shipping to filter results.",
          "type": "string",
          "source": "field",
          "position": "query",
          "required": false,
          "options": ["billing", "shipping"]
        }
      ]
    }
  ],
  "output": {
    "addresses": "out.data"
  },
  "messages": {
    "success": {
      "en": "Addresses loaded."
    },
    "error": {
      "en": "Failed to list addresses: {{MESSAGE}}"
    }
  }
}
