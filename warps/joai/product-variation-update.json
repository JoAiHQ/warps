{
  "protocol": "warp:3.0.0",
  "name": "JoAi: Update Product Variation",
  "title": {
    "en": "Update a product variation",
    "de": "Produktvariante aktualisieren"
  },
  "description": {
    "en": "Update an existing product variation price, name, or visibility. Only the fields you provide are changed.",
    "de": "Aktualisiere Preis, Name oder Sichtbarkeit einer bestehenden Produktvariante. Nur die angegebenen Felder werden geändert."
  },
  "bot": "Use when the user wants to change the price or details of an existing product variation. Price is in cents (100 = €1). List products first to find variation IDs.",
  "vars": {
    "JOAI_AGENT_UUID": "env:JOAI_AGENT_UUID",
    "JOAI_AGENT_AUTH_KEY": "env:JOAI_AGENT_AUTH_KEY",
    "JOAI_TEAM_SLUG": "env:JOAI_TEAM_SLUG"
  },
  "actions": [
    {
      "type": "collect",
      "label": {
        "en": "Update variation",
        "de": "Variante aktualisieren"
      },
      "destination": {
        "url": "INJECT:API_BASE/v1/products/variations/{{variationId}}",
        "method": "PUT",
        "headers": {
          "X-Agent-Auth-Key": "{{JOAI_AGENT_AUTH_KEY}}",
          "X-Team": "{{team}}"
        }
      },
      "inputs": [
        {
          "name": "Variation ID",
          "as": "variationId",
          "description": {
            "en": "The hash ID of the variation to update",
            "de": "Die Hash-ID der zu aktualisierenden Variante"
          },
          "type": "string",
          "source": "field",
          "position": "url:variationId",
          "required": true
        },
        {
          "name": "Price",
          "as": "price",
          "description": {
            "en": "Price per unit in cents",
            "de": "Preis pro Einheit in Cent"
          },
          "type": "number",
          "source": "field",
          "required": false
        },
        {
          "name": "Name",
          "as": "name",
          "description": {
            "en": "Variation name",
            "de": "Variantenname"
          },
          "type": "string",
          "source": "field",
          "required": false
        },
        {
          "name": "Active",
          "as": "active",
          "description": {
            "en": "Whether the variation is active (\"true\"/\"false\")",
            "de": "Ob die Variante aktiv ist (\"true\"/\"false\")"
          },
          "type": "string",
          "source": "field",
          "required": false
        },
        {
          "name": "Team",
          "as": "team",
          "description": {
            "en": "Team slug of the product. Defaults to the current team.",
            "de": "Team-Slug des Produkts. Standardmäßig das aktuelle Team."
          },
          "bot": "The slug of the team the product belongs to. Omit to use the current team.",
          "type": "string",
          "source": "field",
          "required": false,
          "default": "{{JOAI_TEAM_SLUG}}"
        }
      ]
    }
  ],
  "messages": {
    "success": {
      "en": "Product variation updated.",
      "de": "Produktvariante aktualisiert."
    }
  }
}
