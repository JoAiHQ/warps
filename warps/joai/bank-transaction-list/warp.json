{
  "protocol": "warp:3.0.0",
  "name": "JoAi: List Bank Transactions",
  "title": {
    "en": "List bank transactions",
    "de": "Bankumsätze anzeigen",
    "fr": "Lister les transactions bancaires",
    "es": "Listar movimientos bancarios",
    "it": "Elenca movimenti bancari",
    "ro": "Listează tranzacțiile bancare"
  },
  "description": {
    "en": "List imported bank transactions with filters for account, status, date and search.",
    "de": "Importierte Bankumsätze mit Filtern für Konto, Status, Datum und Suche anzeigen.",
    "fr": "Liste les transactions bancaires importées avec filtres par compte, statut, date et recherche.",
    "es": "Lista movimientos bancarios importados con filtros por cuenta, estado, fecha y búsqueda.",
    "it": "Elenca i movimenti bancari importati con filtri per conto, stato, data e ricerca.",
    "ro": "Listează tranzacțiile bancare importate cu filtre după cont, stare, dată și căutare."
  },
  "bot": "Use when the user wants to review imported bank transactions.",
  "vars": {
    "JOAI_AGENT_AUTH_KEY": "env:JOAI_AGENT_AUTH_KEY",
    "JOAI_TEAM_SLUG": "env:JOAI_TEAM_SLUG"
  },
  "actions": [
    {
      "type": "collect",
      "label": {
        "en": "List bank transactions",
        "de": "Bankumsätze anzeigen",
        "fr": "Lister les transactions",
        "es": "Listar movimientos",
        "it": "Elenca movimenti",
        "ro": "Listează tranzacțiile"
      },
      "destination": {
        "url": "INJECT:API_BASE/v1/teams/{{team}}/bank-transactions?bankAccountId={{bankAccountId}}&status={{status}}&from={{from}}&to={{to}}&search={{search}}&page={{page}}&perPage={{perPage}}",
        "method": "GET",
        "headers": {
          "X-Agent-Auth-Key": "{{JOAI_AGENT_AUTH_KEY}}",
          "X-Team": "{{team}}"
        }
      },
      "inputs": [
        {
          "name": "Bank account ID",
          "as": "bankAccountId",
          "type": "string",
          "source": "field",
          "required": false,
          "description": {
            "en": "Bank account hash ID",
            "de": "Bankkonto-Hash-ID",
            "fr": "Hash ID du compte bancaire",
            "es": "Hash ID de la cuenta bancaria",
            "it": "Hash ID del conto bancario",
            "ro": "Hash ID-ul contului bancar"
          },
          "position": "query"
        },
        {
          "name": "Status",
          "as": "status",
          "type": "string",
          "source": "field",
          "required": false,
          "description": {
            "en": "Filter by status",
            "de": "Nach Status filtern",
            "fr": "Filtrer par statut",
            "es": "Filtrar por estado",
            "it": "Filtra per stato",
            "ro": "Filtrează după stare"
          },
          "options": [
            "open",
            "matched",
            "booked",
            "ignored"
          ],
          "position": "query"
        },
        {
          "name": "From",
          "as": "from",
          "type": "string",
          "source": "field",
          "required": false,
          "description": {
            "en": "First booking date (YYYY-MM-DD)",
            "de": "Erstes Buchungsdatum (JJJJ-MM-TT)",
            "fr": "Première date d’écriture (AAAA-MM-JJ)",
            "es": "Primera fecha de asiento (AAAA-MM-DD)",
            "it": "Prima data registrazione (AAAA-MM-GG)",
            "ro": "Prima dată de înregistrare (AAAA-LL-ZZ)"
          },
          "position": "query"
        },
        {
          "name": "To",
          "as": "to",
          "type": "string",
          "source": "field",
          "required": false,
          "description": {
            "en": "Last booking date (YYYY-MM-DD)",
            "de": "Letztes Buchungsdatum (JJJJ-MM-TT)",
            "fr": "Dernière date d’écriture (AAAA-MM-JJ)",
            "es": "Última fecha de asiento (AAAA-MM-DD)",
            "it": "Ultima data registrazione (AAAA-MM-GG)",
            "ro": "Ultima dată de înregistrare (AAAA-LL-ZZ)"
          },
          "position": "query"
        },
        {
          "name": "Search",
          "as": "search",
          "type": "string",
          "source": "field",
          "required": false,
          "description": {
            "en": "Search counterparty, reference, IBAN or external ID",
            "de": "Gegenpartei, Verwendungszweck, IBAN oder externe ID durchsuchen",
            "fr": "Rechercher contrepartie, référence, IBAN ou ID externe",
            "es": "Buscar contraparte, referencia, IBAN o ID externo",
            "it": "Cerca controparte, riferimento, IBAN o ID esterno",
            "ro": "Caută contrapartidă, referință, IBAN sau ID extern"
          },
          "position": "query"
        },
        {
          "name": "Page",
          "as": "page",
          "type": "uint16",
          "source": "field",
          "required": false,
          "description": {
            "en": "Page number (default 1)",
            "de": "Seitennummer (Standard 1)",
            "fr": "Numéro de page (par défaut 1)",
            "es": "Número de página (por defecto 1)",
            "it": "Numero pagina (predefinito 1)",
            "ro": "Numărul paginii (implicit 1)"
          },
          "default": "1",
          "position": "query"
        },
        {
          "name": "Per page",
          "as": "perPage",
          "type": "uint16",
          "source": "field",
          "required": false,
          "description": {
            "en": "Results per page (max 100)",
            "de": "Ergebnisse pro Seite (max. 100)",
            "fr": "Résultats par page (max 100)",
            "es": "Resultados por página (máx. 100)",
            "it": "Risultati per pagina (max 100)",
            "ro": "Rezultate pe pagină (max. 100)"
          },
          "default": "50",
          "position": "query"
        },
        {
          "name": "Team",
          "as": "team",
          "type": "string",
          "position": "url:team",
          "source": "field",
          "required": false,
          "default": "{{JOAI_TEAM_SLUG}}",
          "description": {
            "en": "Team slug for this action. Defaults to the current team.",
            "de": "Team-Slug für diese Aktion. Standardmäßig das aktuelle Team.",
            "fr": "Slug de l’équipe pour cette action. Par défaut, l’équipe actuelle.",
            "es": "Slug del equipo para esta acción. Por defecto, el equipo actual.",
            "it": "Slug del team per questa azione. Predefinito: team attuale.",
            "ro": "Slug-ul echipei pentru această acțiune. Implicit echipa curentă."
          },
          "bot": "The slug of the team to operate on. Omit to use the current team."
        }
      ],
      "auto": true,
      "output": {
        "transactions": "out.data",
        "transactionsCount": "out.data.length"
      }
    }
  ],
  "output": {
    "BANK_TRANSACTIONS": "out.data"
  },
  "ui": "https://raw.githubusercontent.com/JoAiHQ/warps/main/warps/joai/bank-transaction-list/chatapp.1ebacf76.dist.html"
}