{
  "protocol": "warp:3.0.0",
  "name": "JoAi: Send Campaign Message",
  "title": {
    "en": "Send personalized campaign message",
    "de": "Personalisierte Kampagnennachricht senden",
    "es": "Send personalized campaign message",
    "fr": "Send personalized campaign message",
    "ro": "Send personalized campaign message",
    "it": "Send personalized campaign message"
  },
  "description": {
    "en": "Sends one personalized JoAi campaign message to a contact after AI placeholders were filled, then marks that campaign contact as delivered. Use during campaign approval batches so each recipient gets a reviewed subject and body on email or SMS.",
    "de": "Sendet eine personalisierte JoAi-Kampagnennachricht an einen Kontakt, nachdem KI-Platzhalter befüllt wurden, und markiert den Kampagnenkontakt danach als zugestellt. Nutze das in Freigabe-Batches, damit jede Empfängerin und jeder Empfänger einen geprüften Betreff und Text per E-Mail oder SMS erhält.",
    "es": "Sends one personalized JoAi campaign message to a contact after AI placeholders were filled, then marks that campaign contact as delivered. Use during campaign approval batches so each recipient gets a reviewed subject and body on email or SMS.",
    "fr": "Sends one personalized JoAi campaign message to a contact after AI placeholders were filled, then marks that campaign contact as delivered. Use during campaign approval batches so each recipient gets a reviewed subject and body on email or SMS.",
    "ro": "Sends one personalized JoAi campaign message to a contact after AI placeholders were filled, then marks that campaign contact as delivered. Use during campaign approval batches so each recipient gets a reviewed subject and body on email or SMS.",
    "it": "Sends one personalized JoAi campaign message to a contact after AI placeholders were filled, then marks that campaign contact as delivered. Use during campaign approval batches so each recipient gets a reviewed subject and body on email or SMS."
  },
  "bot": "Use to send one personalized campaign message after AI placeholders were filled. Provide contactId, campaignId, channel, subject, and message.",
  "vars": {
    "JOAI_AGENT_UUID": "env:JOAI_AGENT_UUID",
    "JOAI_AGENT_AUTH_KEY": "env:JOAI_AGENT_AUTH_KEY",
    "JOAI_TEAM_SLUG": "env:JOAI_TEAM_SLUG",
    "CONTACT_ID": "query:contactId",
    "CAMPAIGN_ID": "query:campaignId",
    "CHANNEL": "query:channel",
    "RECIPIENT_ID": "query:recipientId",
    "RECIPIENT_NAME": "query:recipientName"
  },
  "actions": [
    {
      "type": "collect",
      "label": {
        "en": "Review message",
        "de": "Nachricht prüfen"
      },
      "inputs": [
        {
          "name": "Subject",
          "as": "subject",
          "description": {
            "en": "Email subject (optional for other channels)",
            "de": "E-Mail-Betreff (optional für andere Kanäle)"
          },
          "type": "string",
          "source": "field",
          "required": false,
          "position": "local"
        },
        {
          "name": "Message",
          "as": "message",
          "description": {
            "en": "Final message body to send",
            "de": "Endgültiger Nachrichtentext"
          },
          "type": "string",
          "source": "field",
          "required": true,
          "position": "local"
        },
        {
          "name": "Team",
          "as": "team",
          "type": "string",
          "source": "hidden",
          "required": false,
          "default": "{{JOAI_TEAM_SLUG}}",
          "position": "local"
        }
      ]
    },
    {
      "type": "collect",
      "auto": true,
      "label": {
        "en": "Send message",
        "de": "Nachricht senden"
      },
      "destination": {
        "url": "INJECT:API_BASE/v1/agents/{{JOAI_AGENT_UUID}}/room/message",
        "method": "POST",
        "headers": {
          "X-Agent-Auth-Key": "{{JOAI_AGENT_AUTH_KEY}}",
          "X-Team": "{{team}}"
        }
      },
      "inputs": [
        {
          "name": "Integration",
          "as": "integration",
          "type": "string",
          "position": "payload:integration",
          "source": "hidden",
          "default": "{{CHANNEL}}"
        },
        {
          "name": "RecipientId",
          "as": "recipientId",
          "type": "string",
          "position": "payload:recipientId",
          "source": "hidden",
          "default": "{{RECIPIENT_ID}}"
        },
        {
          "name": "RecipientName",
          "as": "recipientName",
          "type": "string",
          "position": "payload:recipientName",
          "source": "hidden",
          "default": "{{RECIPIENT_NAME}}"
        },
        {
          "name": "ContactId",
          "as": "contactId",
          "type": "string",
          "position": "payload:contactId",
          "source": "hidden",
          "default": "{{CONTACT_ID}}"
        },
        {
          "name": "Subject",
          "as": "subject",
          "type": "string",
          "position": "payload:subject",
          "source": "hidden",
          "default": "{{subject}}"
        },
        {
          "name": "Message",
          "as": "message",
          "type": "string",
          "position": "payload:message",
          "source": "hidden",
          "default": "{{message}}"
        },
        {
          "name": "Team",
          "as": "team",
          "type": "string",
          "source": "hidden",
          "default": "{{team}}"
        }
      ]
    },
    {
      "type": "collect",
      "auto": true,
      "label": {
        "en": "Mark delivered",
        "de": "Als zugestellt markieren"
      },
      "destination": {
        "url": "INJECT:API_BASE/v1/campaigns/{{CAMPAIGN_ID}}/contacts/{{CONTACT_ID}}/delivered",
        "method": "POST",
        "headers": {
          "X-Agent-Auth-Key": "{{JOAI_AGENT_AUTH_KEY}}",
          "X-Team": "{{team}}"
        }
      },
      "inputs": [
        {
          "name": "Team",
          "as": "team",
          "type": "string",
          "source": "hidden",
          "default": "{{team}}"
        }
      ]
    }
  ],
  "messages": {
    "success": {
      "en": "Campaign message sent.",
      "de": "Kampagnennachricht gesendet."
    }
  }
}
