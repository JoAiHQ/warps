{
  "protocol": "warp:3.0.0",
  "name": "Routes: Create",
  "title": {
    "en": "Create route",
    "de": "Route erstellen",
    "es": "Crear ruta",
    "fr": "Créer un parcours",
    "it": "Crea percorso",
    "ro": "Creează traseu"
  },
  "description": {
    "en": "Create a team route with optional media and publication settings.",
    "de": "Erstellt eine Team-Route mit optionalen Medien und Veröffentlichungseinstellungen.",
    "es": "Crea una ruta del equipo con medios y ajustes de publicación opcionales.",
    "fr": "Crée un parcours d’équipe avec médias et paramètres de publication facultatifs.",
    "it": "Crea un percorso del team con media e impostazioni di pubblicazione opzionali.",
    "ro": "Creează un traseu al echipei cu media și setări de publicare opționale."
  },
  "bot": "Requires team manage permission. Use a stable slug; it is unique within the team.",
  "vars": {
    "JOAI_AGENT_AUTH_KEY": "env:JOAI_AGENT_AUTH_KEY",
    "JOAI_TEAM_SLUG": "env:JOAI_TEAM_SLUG"
  },
  "actions": [
    {
      "type": "collect",
      "label": {
        "en": "Create route",
        "de": "Route erstellen",
        "es": "Crear ruta",
        "fr": "Créer un parcours",
        "it": "Crea percorso",
        "ro": "Creează traseu"
      },
      "destination": {
        "url": "INJECT:API_BASE/v1/routes",
        "method": "POST",
        "headers": {
          "X-Agent-Auth-Key": "{{JOAI_AGENT_AUTH_KEY}}",
          "Accept": "application/json"
        }
      },
      "inputs": [
        {
          "name": "Team",
          "as": "team",
          "type": "string",
          "source": "field",
          "required": false,
          "default": "{{JOAI_TEAM_SLUG}}",
          "description": {
            "en": "Team slug.",
            "de": "Team-Slug.",
            "es": "Slug del equipo.",
            "fr": "Slug de l’équipe.",
            "it": "Slug del team.",
            "ro": "Slugul echipei."
          }
        },
        {
          "name": "Slug",
          "as": "slug",
          "type": "string",
          "source": "field",
          "required": true,
          "description": {
            "en": "Route slug.",
            "de": "Routen-Slug.",
            "es": "Slug de la ruta.",
            "fr": "Slug du parcours.",
            "it": "Slug del percorso.",
            "ro": "Slugul traseului."
          }
        },
        {
          "name": "Name",
          "as": "name",
          "type": "string",
          "source": "field",
          "required": true,
          "description": {
            "en": "Route name.",
            "de": "Routenname.",
            "es": "Nombre de la ruta.",
            "fr": "Nom du parcours.",
            "it": "Nome del percorso.",
            "ro": "Numele traseului."
          }
        },
        {
          "name": "Tagline",
          "as": "tagline",
          "type": "string",
          "source": "field",
          "required": false,
          "description": {
            "en": "Short tagline.",
            "de": "Kurzbeschreibung.",
            "es": "Frase corta.",
            "fr": "Accroche courte.",
            "it": "Tagline breve.",
            "ro": "Slogan scurt."
          }
        },
        {
          "name": "Description",
          "as": "description",
          "type": "string",
          "source": "field",
          "required": false,
          "description": {
            "en": "Longer description.",
            "de": "Längere Beschreibung.",
            "es": "Descripción más larga.",
            "fr": "Description plus longue.",
            "it": "Descrizione più lunga.",
            "ro": "Descriere mai lungă."
          }
        },
        {
          "name": "Tags",
          "as": "tags",
          "type": "json",
          "source": "field",
          "required": false,
          "description": {
            "en": "JSON array of tags.",
            "de": "JSON-Array mit Tags.",
            "es": "Array JSON de etiquetas.",
            "fr": "Tableau JSON de tags.",
            "it": "Array JSON di tag.",
            "ro": "Array JSON de etichete."
          }
        },
        {
          "name": "Public",
          "as": "public",
          "type": "boolean",
          "source": "field",
          "required": false,
          "description": {
            "en": "Public visibility.",
            "de": "Öffentliche Sichtbarkeit.",
            "es": "Visibilidad pública.",
            "fr": "Visibilité publique.",
            "it": "Visibilità pubblica.",
            "ro": "Vizibilitate publică."
          }
        },
        {
          "name": "Published at",
          "as": "publishedAt",
          "type": "string",
          "source": "field",
          "required": false,
          "description": {
            "en": "ISO publication time.",
            "de": "ISO-Veröffentlichungszeit.",
            "es": "Fecha ISO de publicación.",
            "fr": "Date ISO de publication.",
            "it": "Data ISO di pubblicazione.",
            "ro": "Data ISO de publicare."
          }
        },
        {
          "name": "Meta",
          "as": "meta",
          "type": "json",
          "source": "field",
          "required": false,
          "description": {
            "en": "JSON metadata.",
            "de": "JSON-Metadaten.",
            "es": "Metadatos JSON.",
            "fr": "Métadonnées JSON.",
            "it": "Metadati JSON.",
            "ro": "Metadate JSON."
          }
        },
        {
          "name": "Cover",
          "as": "cover",
          "type": "json",
          "source": "field",
          "required": false,
          "description": {
            "en": "Cover media hashids.",
            "de": "Hashids der Titelbild-Medien.",
            "es": "Hashids de medios de portada.",
            "fr": "Hashids des médias de couverture.",
            "it": "Hashid dei media di copertina.",
            "ro": "Hashid-urile media de copertă."
          }
        },
        {
          "name": "Gallery",
          "as": "gallery",
          "type": "json",
          "source": "field",
          "required": false,
          "description": {
            "en": "Gallery media hashids.",
            "de": "Hashids der Galerie-Medien.",
            "es": "Hashids de medios de galería.",
            "fr": "Hashids des médias de galerie.",
            "it": "Hashid dei media di galleria.",
            "ro": "Hashid-urile media din galerie."
          }
        }
      ],
      "output": {
        "id": "out.data.id",
        "slug": "out.data.slug",
        "name": "out.data.name"
      }
    }
  ],
  "output": {
    "ROUTE_ID": "out.data.id",
    "ROUTE_SLUG": "out.data.slug",
    "ROUTE_NAME": "out.data.name"
  },
  "messages": {
    "success": {
      "en": "Route created.",
      "de": "Route erstellt.",
      "es": "Ruta creada.",
      "fr": "Parcours créé.",
      "it": "Percorso creato.",
      "ro": "Traseu creat."
    }
  }
}
