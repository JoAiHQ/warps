{
  "protocol": "warp:3.0.0",
  "name": "JoAi: Update Site",
  "title": {
    "en": "Update site",
    "de": "Website aktualisieren",
    "es": "Update site",
    "fr": "Update site",
    "ro": "Update site",
    "it": "Update site"
  },
  "description": {
    "en": "Update a site’s enabled state, name, URL, type (undefined|shop), contact, metrics source/resource, or monthly report schedule.",
    "de": "Aktualisiert Aktivierung, Name, URL, Typ (undefined|shop), Kontakt, Metrik-Quelle/-Ressource oder Monatsbericht einer Website."
  },
  "bot": "Update site fields including optional type. type=shop requires url, only works on brandless sites, and marks this site as the post-checkout storefront return URL (one shop per team). Pass type=undefined (or empty) to clear shop. Pass metricsSource and metricsResource together. monthlyReport=true opts into the 1st-of-month job when contact and metrics are set — it does not send immediately. If enabling monthlyReport returns channel_not_configured for cloudflare, call settings-integration-open with integration=cloudflare, then retry.",
  "vars": {
    "JOAI_AGENT_AUTH_KEY": "env:JOAI_AGENT_AUTH_KEY",
    "JOAI_TEAM_SLUG": "env:JOAI_TEAM_SLUG"
  },
  "actions": [
    {
      "type": "collect",
      "label": {
        "en": "Update",
        "de": "Aktualisieren"
      },
      "destination": {
        "url": "INJECT:API_BASE/v1/sites/{{siteId}}",
        "method": "PUT",
        "headers": {
          "X-Agent-Auth-Key": "{{JOAI_AGENT_AUTH_KEY}}",
          "X-Team": "{{team}}"
        }
      },
      "inputs": [
        {
          "name": "Site ID",
          "as": "siteId",
          "type": "string",
          "source": "field",
          "required": true,
          "position": "url:siteId"
        },
        {
          "name": "Team",
          "as": "team",
          "type": "string",
          "source": "field",
          "required": false,
          "default": "{{JOAI_TEAM_SLUG}}"
        },
        {
          "name": "Enabled",
          "as": "enabled",
          "type": "boolean",
          "source": "field",
          "required": false,
          "position": "payload:enabled"
        },
        {
          "name": "Name",
          "as": "name",
          "type": "string",
          "source": "field",
          "required": false,
          "position": "payload:name"
        },
        {
          "name": "Website URL",
          "as": "url",
          "type": "string",
          "source": "field",
          "required": false,
          "position": "payload:url"
        },
        {
          "name": "Type",
          "as": "type",
          "type": "string",
          "source": "field",
          "required": false,
          "position": "payload:type",
          "options": {
            "undefined": "Website",
            "shop": "Shop"
          },
          "description": {
            "en": "undefined = normal website/portfolio. shop = storefront return URL after checkout (brandless sites only).",
            "de": "undefined = normale Website/Portfolio. shop = Shop-URL nach Checkout (nur ohne Brand)."
          }
        },
        {
          "name": "Contact",
          "as": "contactId",
          "type": "string",
          "source": "field",
          "required": false,
          "position": "payload:contactId"
        },
        {
          "name": "Metrics source",
          "as": "metricsSource",
          "type": "string",
          "source": "field",
          "required": false,
          "position": "payload:metricsSource"
        },
        {
          "name": "Metrics resource",
          "as": "metricsResource",
          "type": "string",
          "source": "field",
          "required": false,
          "position": "payload:metricsResource"
        },
        {
          "name": "Monthly report",
          "as": "monthlyReport",
          "type": "boolean",
          "source": "field",
          "required": false,
          "position": "payload:monthlyReport"
        }
      ]
    }
  ],
  "messages": {
    "success": {
      "en": "Site updated.",
      "de": "Website aktualisiert."
    }
  }
}
