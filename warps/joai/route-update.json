{
  "protocol": "warp:3.0.0",
  "name": "Routes: Update",
  "title": {
    "en": "Update route",
    "de": "Route aktualisieren",
    "es": "Actualizar ruta",
    "fr": "Modifier le parcours",
    "it": "Aggiorna percorso",
    "ro": "Actualizează traseul"
  },
  "description": {
    "en": "Update route fields, visibility or media. Send only the fields that change.",
    "de": "Aktualisiert Felder, Sichtbarkeit oder Medien einer Route. Nur geänderte Felder senden.",
    "es": "Actualiza campos, visibilidad o medios de una ruta. Envía solo los campos que cambian.",
    "fr": "Modifie les champs, la visibilité ou les médias d’un parcours. N’envoyez que les champs modifiés.",
    "it": "Aggiorna campi, visibilità o media di un percorso. Invia solo i campi modificati.",
    "ro": "Actualizează câmpurile, vizibilitatea sau media unui traseu. Trimite doar câmpurile modificate."
  },
  "bot": "Send only changed fields; empty media arrays clear that collection.",
  "vars": {
    "JOAI_AGENT_AUTH_KEY": "env:JOAI_AGENT_AUTH_KEY",
    "JOAI_TEAM_SLUG": "env:JOAI_TEAM_SLUG"
  },
  "actions": [
    {
      "type": "collect",
      "label": {
        "en": "Update route",
        "de": "Route aktualisieren",
        "es": "Actualizar ruta",
        "fr": "Modifier le parcours",
        "it": "Aggiorna percorso",
        "ro": "Actualizează traseul"
      },
      "destination": {
        "url": "INJECT:API_BASE/v1/routes/{{id}}",
        "method": "PATCH",
        "headers": {
          "X-Agent-Auth-Key": "{{JOAI_AGENT_AUTH_KEY}}",
          "Accept": "application/json"
        }
      },
      "inputs": [
        {
          "name": "Route ID",
          "as": "id",
          "type": "string",
          "source": "field",
          "required": true,
          "position": "url:id",
          "description": {
            "en": "Route hashid.",
            "de": "Routen-Hashid.",
            "es": "Hashid de la ruta.",
            "fr": "Hashid du parcours.",
            "it": "Hashid del percorso.",
            "ro": "Hashid-ul traseului."
          }
        },
        {
          "name": "Slug",
          "as": "slug",
          "type": "string",
          "source": "field",
          "required": false,
          "description": {
            "en": "Route slug.",
            "de": "Routen-Slug.",
            "es": "Slug de la ruta.",
            "fr": "Slug du parcours.",
            "it": "Slug del percorso.",
            "ro": "Slugul traseului."
          }
        },
        {
          "name": "Name",
          "as": "name",
          "type": "string",
          "source": "field",
          "required": false,
          "description": {
            "en": "Route name.",
            "de": "Routenname.",
            "es": "Nombre de la ruta.",
            "fr": "Nom du parcours.",
            "it": "Nome del percorso.",
            "ro": "Numele traseului."
          }
        },
        {
          "name": "Tagline",
          "as": "tagline",
          "type": "string",
          "source": "field",
          "required": false,
          "description": {
            "en": "Short tagline.",
            "de": "Kurzbeschreibung.",
            "es": "Frase corta.",
            "fr": "Accroche courte.",
            "it": "Tagline breve.",
            "ro": "Slogan scurt."
          }
        },
        {
          "name": "Description",
          "as": "description",
          "type": "string",
          "source": "field",
          "required": false,
          "description": {
            "en": "Longer description.",
            "de": "Längere Beschreibung.",
            "es": "Descripción más larga.",
            "fr": "Description plus longue.",
            "it": "Descrizione più lunga.",
            "ro": "Descriere mai lungă."
          }
        },
        {
          "name": "Tags",
          "as": "tags",
          "type": "json",
          "source": "field",
          "required": false,
          "description": {
            "en": "JSON array of tags.",
            "de": "JSON-Array mit Tags.",
            "es": "Array JSON de etiquetas.",
            "fr": "Tableau JSON de tags.",
            "it": "Array JSON di tag.",
            "ro": "Array JSON de etichete."
          }
        },
        {
          "name": "Public",
          "as": "public",
          "type": "boolean",
          "source": "field",
          "required": false,
          "description": {
            "en": "Public visibility.",
            "de": "Öffentliche Sichtbarkeit.",
            "es": "Visibilidad pública.",
            "fr": "Visibilité publique.",
            "it": "Visibilità pubblica.",
            "ro": "Vizibilitate publică."
          }
        },
        {
          "name": "Published at",
          "as": "publishedAt",
          "type": "string",
          "source": "field",
          "required": false,
          "description": {
            "en": "ISO publication time.",
            "de": "ISO-Veröffentlichungszeit.",
            "es": "Fecha ISO de publicación.",
            "fr": "Date ISO de publication.",
            "it": "Data ISO di pubblicazione.",
            "ro": "Data ISO de publicare."
          }
        },
        {
          "name": "Meta",
          "as": "meta",
          "type": "json",
          "source": "field",
          "required": false,
          "description": {
            "en": "JSON metadata.",
            "de": "JSON-Metadaten.",
            "es": "Metadatos JSON.",
            "fr": "Métadonnées JSON.",
            "it": "Metadati JSON.",
            "ro": "Metadate JSON."
          }
        },
        {
          "name": "Cover",
          "as": "cover",
          "type": "json",
          "source": "field",
          "required": false,
          "description": {
            "en": "Cover media hashids.",
            "de": "Hashids der Titelbild-Medien.",
            "es": "Hashids de medios de portada.",
            "fr": "Hashids des médias de couverture.",
            "it": "Hashid dei media di copertina.",
            "ro": "Hashid-urile media de copertă."
          }
        },
        {
          "name": "Gallery",
          "as": "gallery",
          "type": "json",
          "source": "field",
          "required": false,
          "description": {
            "en": "Gallery media hashids.",
            "de": "Hashids der Galerie-Medien.",
            "es": "Hashids de medios de galería.",
            "fr": "Hashids des médias de galerie.",
            "it": "Hashid dei media di galleria.",
            "ro": "Hashid-urile media din galerie."
          }
        }
      ],
      "output": {
        "id": "out.data.id",
        "name": "out.data.name"
      }
    }
  ],
  "output": {
    "ROUTE_ID": "out.data.id",
    "ROUTE_NAME": "out.data.name"
  },
  "messages": {
    "success": {
      "en": "Route updated.",
      "de": "Route aktualisiert.",
      "es": "Ruta actualizada.",
      "fr": "Parcours mis à jour.",
      "it": "Percorso aggiornato.",
      "ro": "Traseu actualizat."
    }
  }
}
