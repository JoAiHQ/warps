{
  "protocol": "warp:3.0.0",
  "name": "Routes: Remove Stop",
  "title": {
    "en": "Remove route stop",
    "de": "Station entfernen",
    "es": "Quitar parada",
    "fr": "Retirer l’étape",
    "it": "Rimuovi tappa",
    "ro": "Elimină oprirea"
  },
  "description": {
    "en": "Remove a stop and renumber the remaining stops.",
    "de": "Entfernt eine Station und nummeriert die verbleibenden Stationen neu.",
    "es": "Quita una parada y renumera las paradas restantes.",
    "fr": "Retire une étape et renumérote les étapes restantes.",
    "it": "Rimuove una tappa e rinumera le tappe rimanenti.",
    "ro": "Elimină o oprire și renumerotează opririle rămase."
  },
  "bot": "Requires team manage permission.",
  "vars": {
    "JOAI_AGENT_AUTH_KEY": "env:JOAI_AGENT_AUTH_KEY",
    "JOAI_TEAM_SLUG": "env:JOAI_TEAM_SLUG"
  },
  "actions": [
    {
      "type": "collect",
      "label": {
        "en": "Remove route stop",
        "de": "Station entfernen",
        "es": "Quitar parada",
        "fr": "Retirer l’étape",
        "it": "Rimuovi tappa",
        "ro": "Elimină oprirea"
      },
      "destination": {
        "url": "INJECT:API_BASE/v1/route-stops/{{stopId}}",
        "method": "DELETE",
        "headers": {
          "X-Agent-Auth-Key": "{{JOAI_AGENT_AUTH_KEY}}",
          "Accept": "application/json"
        }
      },
      "inputs": [
        {
          "name": "Stop ID",
          "as": "stopId",
          "type": "string",
          "source": "field",
          "required": true,
          "position": "url:stopId",
          "description": {
            "en": "Route stop hashid.",
            "de": "Hashid der Station.",
            "es": "Hashid de la parada.",
            "fr": "Hashid de l’étape.",
            "it": "Hashid della tappa.",
            "ro": "Hashid-ul opririi."
          }
        }
      ]
    }
  ],
  "messages": {
    "success": {
      "en": "Stop removed.",
      "de": "Station entfernt.",
      "es": "Parada quitada.",
      "fr": "Étape retirée.",
      "it": "Tappa rimossa.",
      "ro": "Oprire eliminată."
    }
  }
}
