{
  "protocol": "warp:3.0.0",
  "name": "JoAi: Create KV",
  "title": {
    "en": "Create a KV",
    "de": "KV erstellen",
    "es": "Crear un KV",
    "fr": "Créer un KV",
    "ro": "Creează un KV",
    "it": "Crea un KV"
  },
  "description": {
    "en": "Create a new KV field for time-series or scalar data (weight, expenses, habits, etc.).",
    "de": "Erstelle ein neues KV-Feld für Zeitreihen- oder Einzelwerte (Gewicht, Ausgaben, Gewohnheiten usw.).",
    "es": "Crea un nuevo campo KV para datos de series temporales o escalares (peso, gastos, hábitos, etc.).",
    "fr": "Crée un nouveau champ KV pour des données de séries temporelles ou scalaires (poids, dépenses, habitudes, etc.).",
    "ro": "Creează un câmp KV nou pentru date de serie temporală sau scalare (greutate, cheltuieli, obiceiuri etc.).",
    "it": "Crea un nuovo campo KV per dati di serie temporali o scalari (peso, spese, abitudini, ecc.)."
  },
  "bot": "Use this when the user wants to start tracking something new over time — weight, expenses, habits, metrics, counters, or any recurring measurement.",
  "vars": {
    "JOAI_AGENT_UUID": "env:JOAI_AGENT_UUID",
    "JOAI_AGENT_AUTH_KEY": "env:JOAI_AGENT_AUTH_KEY"
  },
  "actions": [
    {
      "type": "collect",
      "label": {
        "en": "Create KV",
        "de": "KV erstellen",
        "es": "Crear KV",
        "fr": "Créer KV",
        "ro": "Creează KV",
        "it": "Crea KV"
      },
      "destination": {
        "url": "INJECT:API_BASE/v1/kv",
        "method": "POST",
        "headers": {
          "X-Agent-Auth-Key": "{{JOAI_AGENT_AUTH_KEY}}"
        }
      },
      "inputs": [
        {
          "name": "Name",
          "as": "name",
          "description": {
            "en": "KV name (e.g. \"weight\", \"expense:food\", \"habit:meditation\")",
            "de": "Name des KV-Felds (z.B. \"weight\", \"expense:food\", \"habit:meditation\")",
            "es": "Nombre del KV (p. ej. \"weight\", \"expense:food\", \"habit:meditation\")",
            "fr": "Nom du KV (p. ex. \"weight\", \"expense:food\", \"habit:meditation\")",
            "ro": "Numele KV (de ex. \"weight\", \"expense:food\", \"habit:meditation\")",
            "it": "Nome del KV (es. \"weight\", \"expense:food\", \"habit:meditation\")"
          },
          "bot": "Short, lowercase KV name. Use colons for namespacing (e.g. \"habit:meditation\", \"expense:food\"). Must be 2-50 chars, alphanumeric with colons/hyphens.",
          "type": "string",
          "source": "field",
          "required": true,
          "min": 2,
          "label": {
            "en": "Name",
            "de": "Name",
            "es": "Name",
            "fr": "Name",
            "ro": "Name",
            "it": "Name"
          }
        },
        {
          "name": "Description",
          "as": "description",
          "description": {
            "en": "What this KV tracks",
            "de": "Was dieses KV-Feld verfolgt",
            "es": "Qué registra este KV",
            "fr": "Ce que ce KV suit",
            "ro": "Ce urmărește acest KV",
            "it": "Cosa traccia questo KV"
          },
          "bot": "A human-readable purpose for this KV field.",
          "type": "string",
          "source": "field",
          "required": false
        },
        {
          "name": "Value Type",
          "as": "valueType",
          "description": {
            "en": "scalar (single value) or series (time-series data)",
            "de": "scalar (Einzelwert) oder series (Zeitreihe)",
            "es": "scalar (single value) or series (time-series data)",
            "fr": "scalar (single value) or series (time-series data)",
            "ro": "scalar (single value) or series (time-series data)",
            "it": "scalar (single value) or series (time-series data)"
          },
          "bot": "Use 'scalar' for a single changing value (e.g. portfolio balance). Use 'series' for data points over time (e.g. daily weight, expenses).",
          "type": "string",
          "source": "field",
          "required": false,
          "default": "series",
          "options": {
            "scalar": "Scalar (single value)",
            "series": "Series (time-series)"
          }
        },
        {
          "name": "Unit",
          "as": "unit",
          "description": {
            "en": "Unit of measurement (e.g. \"lbs\", \"USD\", \"minutes\")",
            "de": "Maßeinheit (z.B. \"kg\", \"EUR\", \"Minuten\")",
            "es": "Unit of measurement (e.g. \"lbs\", \"USD\", \"minutes\")",
            "fr": "Unit of measurement (e.g. \"lbs\", \"USD\", \"minutes\")",
            "ro": "Unit of measurement (e.g. \"lbs\", \"USD\", \"minutes\")",
            "it": "Unit of measurement (e.g. \"lbs\", \"USD\", \"minutes\")"
          },
          "bot": "Optional unit of measurement like 'lbs', 'USD', 'minutes', 'km'.",
          "type": "string",
          "source": "field",
          "required": false,
          "label": {
            "en": "Unit",
            "de": "Unit",
            "es": "Unit",
            "fr": "Unit",
            "ro": "Unit",
            "it": "Unit"
          }
        }
      ]
    }
  ],
  "messages": {
    "success": {
      "en": "Now tracking '{{name}}'!",
      "de": "'{{name}}' wird jetzt verfolgt!",
      "es": "Now tracking '{{name}}'!",
      "fr": "Now tracking '{{name}}'!",
      "ro": "Now tracking '{{name}}'!",
      "it": "Now tracking '{{name}}'!"
    }
  }
}
