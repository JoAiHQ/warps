{
  "protocol": "warp:3.0.0",
  "name": "Routes: Update Stop",
  "title": {
    "en": "Update route stop",
    "de": "Station aktualisieren",
    "es": "Actualizar parada",
    "fr": "Modifier l’étape",
    "it": "Aggiorna tappa",
    "ro": "Actualizează oprirea"
  },
  "description": {
    "en": "Update day, duration, leg mode, notes or meta of a route stop.",
    "de": "Aktualisiert Tag, Dauer, Verkehrsmittel, Notizen oder Meta einer Station.",
    "es": "Actualiza día, duración, modo de trayecto, notas o meta de una parada.",
    "fr": "Modifie le jour, la durée, le mode de trajet, les notes ou les métadonnées d’une étape.",
    "it": "Aggiorna giorno, durata, modalità di spostamento, note o meta di una tappa.",
    "ro": "Actualizează ziua, durata, modul de deplasare, notele sau meta unei opriri."
  },
  "bot": "Place cannot be changed on a stop.",
  "vars": {
    "JOAI_AGENT_AUTH_KEY": "env:JOAI_AGENT_AUTH_KEY",
    "JOAI_TEAM_SLUG": "env:JOAI_TEAM_SLUG"
  },
  "actions": [
    {
      "type": "collect",
      "label": {
        "en": "Update route stop",
        "de": "Station aktualisieren",
        "es": "Actualizar parada",
        "fr": "Modifier l’étape",
        "it": "Aggiorna tappa",
        "ro": "Actualizează oprirea"
      },
      "destination": {
        "url": "INJECT:API_BASE/v1/route-stops/{{stopId}}",
        "method": "PATCH",
        "headers": {
          "X-Agent-Auth-Key": "{{JOAI_AGENT_AUTH_KEY}}",
          "Accept": "application/json"
        }
      },
      "inputs": [
        {
          "name": "Stop ID",
          "as": "stopId",
          "type": "string",
          "source": "field",
          "required": true,
          "position": "url:stopId",
          "description": {
            "en": "Route stop hashid.",
            "de": "Hashid der Station.",
            "es": "Hashid de la parada.",
            "fr": "Hashid de l’étape.",
            "it": "Hashid della tappa.",
            "ro": "Hashid-ul opririi."
          }
        },
        {
          "name": "Day",
          "as": "day",
          "type": "number",
          "source": "field",
          "required": false,
          "description": {
            "en": "Day number.",
            "de": "Tagesnummer.",
            "es": "Número de día.",
            "fr": "Numéro de jour.",
            "it": "Numero del giorno.",
            "ro": "Numărul zilei."
          }
        },
        {
          "name": "Duration minutes",
          "as": "durationMinutes",
          "type": "number",
          "source": "field",
          "required": false,
          "description": {
            "en": "Stop duration in minutes.",
            "de": "Dauer der Station in Minuten.",
            "es": "Duración de la parada en minutos.",
            "fr": "Durée de l’étape en minutes.",
            "it": "Durata della tappa in minuti.",
            "ro": "Durata opririi în minute."
          }
        },
        {
          "name": "Leg mode",
          "as": "legMode",
          "type": "string",
          "source": "field",
          "required": false,
          "description": {
            "en": "walk, bike, car or transit.",
            "de": "Zu Fuß, Rad, Auto oder Öffis.",
            "es": "a pie, bici, coche o transporte público.",
            "fr": "à pied, vélo, voiture ou transport en commun.",
            "it": "a piedi, bici, auto o mezzi pubblici.",
            "ro": "pe jos, bicicletă, mașină sau transport public."
          }
        },
        {
          "name": "Notes",
          "as": "notes",
          "type": "string",
          "source": "field",
          "required": false,
          "description": {
            "en": "Stop notes.",
            "de": "Notizen zur Station.",
            "es": "Notas de la parada.",
            "fr": "Notes de l’étape.",
            "it": "Note della tappa.",
            "ro": "Notele opririi."
          }
        },
        {
          "name": "Meta",
          "as": "meta",
          "type": "json",
          "source": "field",
          "required": false,
          "description": {
            "en": "JSON metadata.",
            "de": "JSON-Metadaten.",
            "es": "Metadatos JSON.",
            "fr": "Métadonnées JSON.",
            "it": "Metadati JSON.",
            "ro": "Metadate JSON."
          }
        }
      ],
      "output": {
        "id": "out.data.id"
      }
    }
  ],
  "output": {
    "STOP_ID": "out.data.id"
  },
  "messages": {
    "success": {
      "en": "Stop updated.",
      "de": "Station aktualisiert.",
      "es": "Parada actualizada.",
      "fr": "Étape mise à jour.",
      "it": "Tappa aggiornata.",
      "ro": "Oprire actualizată."
    }
  }
}
