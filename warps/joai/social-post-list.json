{
  "protocol": "warp:3.0.0",
  "name": "JoAi: List Social Posts",
  "title": {
    "en": "View social posts",
    "de": "Social-Posts anzeigen"
  },
  "description": {
    "en": "List scheduled, published, and failed social posts for the team.",
    "de": "Liste geplante, veröffentlichte und fehlgeschlagene Social-Posts des Teams."
  },
  "bot": "Use this to see the social queue. Filter with status when the user asks for scheduled or failed posts.",
  "vars": {
    "JOAI_AGENT_UUID": "env:JOAI_AGENT_UUID",
    "JOAI_AGENT_AUTH_KEY": "env:JOAI_AGENT_AUTH_KEY",
    "JOAI_TEAM_SLUG": "env:JOAI_TEAM_SLUG"
  },
  "actions": [
    {
      "type": "collect",
      "label": {
        "en": "View posts",
        "de": "Posts anzeigen"
      },
      "destination": {
        "url": "INJECT:API_BASE/v1/social-posts?status={{status}}&platform={{platform}}",
        "method": "GET",
        "headers": {
          "X-Agent-Auth-Key": "{{JOAI_AGENT_AUTH_KEY}}",
          "X-Team": "{{team}}"
        }
      },
      "inputs": [
        {
          "name": "Status",
          "as": "status",
          "description": {
            "en": "Filter by status",
            "de": "Nach Status filtern"
          },
          "type": "string",
          "position": "url:status",
          "source": "field",
          "required": false,
          "options": {
            "draft": "Draft",
            "scheduled": "Scheduled",
            "publishing": "Publishing",
            "published": "Published",
            "failed": "Failed",
            "cancelled": "Cancelled"
          }
        },
        {
          "name": "Network",
          "as": "platform",
          "description": {
            "en": "Filter by network",
            "de": "Nach Netzwerk filtern"
          },
          "type": "string",
          "position": "url:platform",
          "source": "field",
          "required": false,
          "options": {
            "instagram": "Instagram",
            "x": "X",
            "facebook": "Facebook",
            "linkedin": "LinkedIn"
          }
        },
        {
          "name": "Team",
          "as": "team",
          "type": "string",
          "source": "field",
          "required": false,
          "default": "{{JOAI_TEAM_SLUG}}"
        }
      ]
    }
  ]
}
