{
  "protocol": "warp:3.0.0",
  "name": "JoAi: Get Artifact",
  "title": {
    "en": "Get a delivery artifact",
    "de": "Liefer-Artefakt abrufen"
  },
  "description": {
    "en": "Fetch one delivery artifact by ID, including links, contact, and delivery status.",
    "de": "Ein Lieferartefakt per ID abrufen, inkl. Links, Kontakt und Lieferstatus."
  },
  "bot": "Use this before drafting or delivering to load title, summary, urls/links, hasPassword, and contactId. Passwords are hashed and never returned — only hasPassword. If you set a password on create/update, include that plaintext in the delivery message yourself.",
  "vars": {
    "JOAI_AGENT_UUID": "env:JOAI_AGENT_UUID",
    "JOAI_AGENT_AUTH_KEY": "env:JOAI_AGENT_AUTH_KEY",
    "JOAI_TEAM_SLUG": "env:JOAI_TEAM_SLUG"
  },
  "actions": [
    {
      "type": "collect",
      "label": {
        "en": "Get artifact",
        "de": "Artefakt abrufen"
      },
      "destination": {
        "url": "INJECT:API_BASE/v1/artifacts/{{artifactId}}",
        "method": "GET",
        "headers": {
          "X-Agent-Auth-Key": "{{JOAI_AGENT_AUTH_KEY}}",
          "X-Team": "{{team}}"
        }
      },
      "inputs": [
        {
          "name": "Artifact ID",
          "as": "artifactId",
          "type": "string",
          "position": "url:artifactId",
          "source": "field",
          "required": true
        },
        {
          "name": "Team",
          "as": "team",
          "type": "string",
          "source": "field",
          "required": false,
          "default": "{{JOAI_TEAM_SLUG}}",
          "description": {
            "en": "Team slug for this action. Defaults to the current team.",
            "de": "Team-Slug für diese Aktion. Standardmäßig das aktuelle Team."
          },
          "bot": "The slug of the team to operate on. Omit to use the current team."
        }
      ],
      "output": {
        "id": "out.data.id",
        "title": "out.data.title",
        "type": "out.data.type",
        "status": "out.data.status",
        "summary": "out.data.summary",
        "url": "out.data.url",
        "hasPassword": "out.data.hasPassword",
        "links": "out.data.links",
        "contactId": "out.data.contactId",
        "contactEmail": "out.data.contact.email",
        "contactName": "out.data.contact.name"
      }
    }
  ],
  "output": {
    "ARTIFACT_ID": "out.data.id",
    "ARTIFACT_TITLE": "out.data.title",
    "CONTACT_ID": "out.data.contactId",
    "title": "out.data.title",
    "type": "out.data.type",
    "status": "out.data.status",
    "summary": "out.data.summary",
    "url": "out.data.url",
    "hasPassword": "out.data.hasPassword",
    "links": "out.data.links",
    "contactId": "out.data.contactId",
    "contactEmail": "out.data.contact.email",
    "contactName": "out.data.contact.name"
  },
  "messages": {
    "success": {
      "en": "Artifact '{{ARTIFACT_TITLE}}' loaded.",
      "de": "Artefakt '{{ARTIFACT_TITLE}}' geladen."
    }
  }
}
