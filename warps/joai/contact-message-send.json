{
  "protocol": "warp:3.0.0",
  "name": "JoAi: Send Contact Message",
  "title": {
    "en": "Send message to contact",
    "de": "Nachricht an Kontakt senden",
    "es": "Send message to contact",
    "fr": "Send message to contact",
    "ro": "Send message to contact",
    "it": "Send message to contact"
  },
  "description": {
    "en": "Send a message to a contact on the chosen channel (email, SMS, WhatsApp, …).",
    "de": "Nachricht an einen Kontakt über den gewählten Kanal senden (E-Mail, SMS, WhatsApp, …).",
    "es": "Send a message to a contact on the chosen channel (email, SMS, WhatsApp, …).",
    "fr": "Send a message to a contact on the chosen channel (email, SMS, WhatsApp, …).",
    "ro": "Send a message to a contact on the chosen channel (email, SMS, WhatsApp, …).",
    "it": "Send a message to a contact on the chosen channel (email, SMS, WhatsApp, …)."
  },
  "bot": "Send a message to a contact. Provide contactId, recipientId, message; optionally subject, integration, campaignId, and team.",
  "vars": {
    "JOAI_AGENT_UUID": "env:JOAI_AGENT_UUID",
    "JOAI_AGENT_AUTH_KEY": "env:JOAI_AGENT_AUTH_KEY",
    "JOAI_TEAM_SLUG": "env:JOAI_TEAM_SLUG"
  },
  "actions": [
    {
      "type": "collect",
      "label": {
        "en": "Send message",
        "de": "Nachricht senden"
      },
      "destination": {
        "url": "INJECT:API_BASE/v1/agents/{{JOAI_AGENT_UUID}}/room/message",
        "method": "POST",
        "headers": {
          "X-Agent-Auth-Key": "{{JOAI_AGENT_AUTH_KEY}}",
          "X-Team": "{{team}}"
        }
      },
      "inputs": [
        {
          "name": "Subject",
          "as": "subject",
          "description": {
            "en": "Email subject (optional for other channels)",
            "de": "E-Mail-Betreff (optional für andere Kanäle)"
          },
          "type": "string",
          "source": "field",
          "required": false,
          "position": "payload:subject"
        },
        {
          "name": "Message",
          "as": "message",
          "description": {
            "en": "Message body to send",
            "de": "Nachrichtentext"
          },
          "type": "string",
          "source": "field",
          "required": true,
          "position": "payload:message"
        },
        {
          "name": "Contact ID",
          "as": "contactId",
          "description": {
            "en": "Contact to message",
            "de": "Kontakt für die Nachricht"
          },
          "type": "string",
          "source": "field",
          "required": true,
          "position": "payload:contactId"
        },
        {
          "name": "Recipient ID",
          "as": "recipientId",
          "description": {
            "en": "Email or phone to send to",
            "de": "E-Mail oder Telefon für den Versand"
          },
          "type": "string",
          "source": "field",
          "required": true,
          "position": "payload:recipientId"
        },
        {
          "name": "Integration",
          "as": "integration",
          "description": {
            "en": "Channel to send on (email, sms, whatsapp, …)",
            "de": "Kanal für den Versand (email, sms, whatsapp, …)"
          },
          "type": "string",
          "source": "field",
          "required": true,
          "position": "payload:integration"
        },
        {
          "name": "Campaign ID",
          "as": "campaignId",
          "type": "string",
          "source": "field",
          "required": false,
          "position": "payload:campaignId"
        },
        {
          "name": "Team",
          "as": "team",
          "type": "string",
          "source": "hidden",
          "required": false,
          "default": "{{JOAI_TEAM_SLUG}}"
        }
      ]
    }
  ],
  "messages": {
    "success": {
      "en": "Message sent.",
      "de": "Nachricht gesendet.",
      "es": "Message sent.",
      "fr": "Message sent.",
      "ro": "Message sent.",
      "it": "Message sent."
    },
    "error": {
      "en": "Failed to send message: {{MESSAGE}}",
      "de": "Nachricht konnte nicht gesendet werden: {{MESSAGE}}"
    }
  }
}
