{
  "protocol": "warp:3.0.0",
  "name": "JoAi: Send Contact Message",
  "title": {
    "en": "Send message to contact",
    "de": "Nachricht an Kontakt senden",
    "es": "Send message to contact",
    "fr": "Send message to contact",
    "ro": "Send message to contact",
    "it": "Send message to contact"
  },
  "description": {
    "en": "Fetches a contact by ID, lets you review subject and body, then sends the message on the chosen channel (email, SMS, WhatsApp, …).",
    "de": "Holt einen Kontakt anhand der ID, lässt Betreff und Text prüfen und sendet die Nachricht über den gewählten Kanal (E-Mail, SMS, WhatsApp, …).",
    "es": "Fetches a contact by ID, lets you review subject and body, then sends the message on the chosen channel (email, SMS, WhatsApp, …).",
    "fr": "Fetches a contact by ID, lets you review subject and body, then sends the message on the chosen channel (email, SMS, WhatsApp, …).",
    "ro": "Fetches a contact by ID, lets you review subject and body, then sends the message on the chosen channel (email, SMS, WhatsApp, …).",
    "it": "Fetches a contact by ID, lets you review subject and body, then sends the message on the chosen channel (email, SMS, WhatsApp, …)."
  },
  "bot": "Use to send a message to a contact by ID. Pass contactId (and optional integration, recipientId, recipientName, campaignId) on the warp URL/query. Pass subject and message as inputs (or batch inputs). recipientId defaults to the contact email or phone from fetch.",
  "vars": {
    "JOAI_AGENT_UUID": "env:JOAI_AGENT_UUID",
    "JOAI_AGENT_AUTH_KEY": "env:JOAI_AGENT_AUTH_KEY",
    "JOAI_TEAM_SLUG": "env:JOAI_TEAM_SLUG"
  },
  "actions": [
    {
      "type": "collect",
      "auto": true,
      "label": {
        "en": "Fetch contact",
        "de": "Kontakt abrufen"
      },
      "destination": {
        "url": "INJECT:API_BASE/v1/contacts/{{contactId}}",
        "method": "GET",
        "headers": {
          "X-Agent-Auth-Key": "{{JOAI_AGENT_AUTH_KEY}}",
          "X-Team": "{{team}}"
        }
      },
      "inputs": [
        {
          "name": "Contact ID",
          "as": "contactId",
          "description": {
            "en": "Contact to message",
            "de": "Kontakt für die Nachricht"
          },
          "type": "string",
          "source": "field",
          "required": true,
          "position": "url:contactId"
        },
        {
          "name": "Integration",
          "as": "integration",
          "type": "string",
          "source": "hidden",
          "required": false
        },
        {
          "name": "Recipient ID",
          "as": "recipientId",
          "description": {
            "en": "Email or phone override. Defaults to the contact channel address.",
            "de": "E-Mail- oder Telefon-Override. Standard ist die Kanaladresse des Kontakts."
          },
          "type": "string",
          "source": "hidden",
          "required": false
        },
        {
          "name": "Recipient Name",
          "as": "recipientName",
          "type": "string",
          "source": "hidden",
          "required": false
        },
        {
          "name": "Campaign ID",
          "as": "campaignId",
          "type": "string",
          "source": "hidden",
          "required": false
        },
        {
          "name": "Team",
          "as": "team",
          "type": "string",
          "source": "hidden",
          "required": false,
          "default": "{{JOAI_TEAM_SLUG}}"
        }
      ],
      "output": {
        "CONTACT_EMAIL": "out.data.email",
        "CONTACT_NAME": "out.data.name",
        "CONTACT_PHONE": "out.data.phone",
        "TO_ID": "transform:() => inputs.recipientId || results.CONTACT_EMAIL || results.CONTACT_PHONE || ''",
        "TO_NAME": "transform:() => inputs.recipientName || results.CONTACT_NAME || ''"
      }
    },
    {
      "type": "collect",
      "label": {
        "en": "Review message",
        "de": "Nachricht prüfen"
      },
      "inputs": [
        {
          "name": "Subject",
          "as": "subject",
          "description": {
            "en": "Email subject (optional for other channels)",
            "de": "E-Mail-Betreff (optional für andere Kanäle)"
          },
          "type": "string",
          "source": "field",
          "required": false,
          "position": "local"
        },
        {
          "name": "Message",
          "as": "message",
          "description": {
            "en": "Message body to send",
            "de": "Nachrichtentext"
          },
          "type": "string",
          "source": "field",
          "required": true,
          "position": "local"
        },
        {
          "name": "Team",
          "as": "team",
          "type": "string",
          "source": "hidden",
          "required": false,
          "default": "{{JOAI_TEAM_SLUG}}",
          "position": "local"
        }
      ]
    },
    {
      "type": "collect",
      "auto": true,
      "label": {
        "en": "Send message",
        "de": "Nachricht senden"
      },
      "destination": {
        "url": "INJECT:API_BASE/v1/agents/{{JOAI_AGENT_UUID}}/room/message",
        "method": "POST",
        "headers": {
          "X-Agent-Auth-Key": "{{JOAI_AGENT_AUTH_KEY}}",
          "X-Team": "{{team}}"
        }
      },
      "inputs": [
        {
          "name": "Integration",
          "as": "integration",
          "type": "string",
          "position": "payload:integration",
          "source": "hidden",
          "default": "{{integration}}"
        },
        {
          "name": "RecipientId",
          "as": "recipientId",
          "type": "string",
          "position": "payload:recipientId",
          "source": "hidden",
          "default": "{{TO_ID}}"
        },
        {
          "name": "RecipientName",
          "as": "recipientName",
          "type": "string",
          "position": "payload:recipientName",
          "source": "hidden",
          "default": "{{TO_NAME}}"
        },
        {
          "name": "ContactId",
          "as": "contactId",
          "type": "string",
          "position": "payload:contactId",
          "source": "hidden",
          "default": "{{contactId}}"
        },
        {
          "name": "CampaignId",
          "as": "campaignId",
          "type": "string",
          "position": "payload:campaignId",
          "source": "hidden",
          "default": "{{campaignId}}"
        },
        {
          "name": "Subject",
          "as": "subject",
          "type": "string",
          "position": "payload:subject",
          "source": "hidden",
          "default": "{{subject}}"
        },
        {
          "name": "Message",
          "as": "message",
          "type": "string",
          "position": "payload:message",
          "source": "hidden",
          "default": "{{message}}"
        },
        {
          "name": "Team",
          "as": "team",
          "type": "string",
          "source": "hidden",
          "default": "{{team}}"
        }
      ]
    }
  ],
  "messages": {
    "success": {
      "en": "Message sent.",
      "de": "Nachricht gesendet.",
      "es": "Message sent.",
      "fr": "Message sent.",
      "ro": "Message sent.",
      "it": "Message sent."
    },
    "error": {
      "en": "Failed to send message: {{MESSAGE}}",
      "de": "Nachricht konnte nicht gesendet werden: {{MESSAGE}}"
    }
  }
}
