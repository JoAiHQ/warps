{
  "protocol": "warp:3.0.0",
  "name": "OpenCode (CLI): Cancel Task",
  "title": {
    "en": "Cancel task (OpenCode)",
    "es": "Cancelar tarea (OpenCode)",
    "fr": "Annuler la tâche (OpenCode)",
    "ro": "Anulați sarcina (OpenCode)",
    "it": "Annulla attività (OpenCode)"
  },
  "description": {
    "en": "Request cancellation through the local OpenCode CLI.",
    "es": "Solicitar cancelación a través de la CLI local de OpenCode.",
    "fr": "Demander l'annulation via la CLI OpenCode locale.",
    "ro": "Solicitați anularea prin CLI-ul local OpenCode.",
    "it": "Richiedi la cancellazione tramite la CLI OpenCode locale."
  },
  "cli": {
    "mode": "session"
  },
  "actions": [
    {
      "type": "prompt",
      "label": {
        "en": "Cancel Task",
        "es": "Cancelar tarea",
        "fr": "Annuler la tâche",
        "ro": "Anulează sarcina",
        "it": "Annulla attività"
      },
      "cli": {
        "mode": "session"
      },
      "prompt": "/opencode run \"For run ID {{RUN_ID}}, stop work now and return only: cancel_requested.\"",
      "inputs": [
        {
          "name": "Run ID",
          "as": "RUN_ID",
          "description": {
            "en": "Run identifier to cancel.",
            "es": "Identificador de ejecución a cancelar.",
            "fr": "Identifiant d'exécution à annuler.",
            "ro": "Identificatorul de rulare de anulat.",
            "it": "Identificatore di esecuzione da annullare."
          },
          "type": "string",
          "source": "field",
          "required": true
        }
      ]
    }
  ],
  "output": {
    "RUN_ID": "in.RUN_ID",
    "RUN_STATUS": "transform:() => 'cancel_requested'",
    "SUMMARY": "transform:() => 'Cancellation requested via OpenCode CLI.'"
  },
  "messages": {
    "success": {
      "en": "Cancellation requested for {{RUN_ID}}.",
      "es": "Cancelación solicitada para {{RUN_ID}}.",
      "fr": "Annulation demandée pour {{RUN_ID}}.",
      "ro": "Anularea a fost solicitată pentru {{RUN_ID}}.",
      "it": "Cancellazione richiesta per {{RUN_ID}}."
    }
  }
}
