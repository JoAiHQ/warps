{
  "protocol": "warp:3.0.0",
  "name": "OpenCode (CLI): Add Follow-up",
  "title": {
    "en": "Add follow-up (OpenCode)",
    "es": "Añadir seguimiento (OpenCode)",
    "fr": "Ajouter un suivi (OpenCode)",
    "ro": "Adăugați continuare (OpenCode)",
    "it": "Aggiungi follow-up (OpenCode)"
  },
  "description": {
    "en": "Send a follow-up instruction through the local OpenCode CLI.",
    "es": "Enviar una instrucción de seguimiento a través de la CLI local de OpenCode.",
    "fr": "Envoyez une instruction de suivi via la CLI OpenCode locale.",
    "ro": "Trimiteți o instrucțiune ulterioară prin CLI-ul local OpenCode.",
    "it": "Invia un'istruzione di follow-up tramite la CLI OpenCode locale."
  },
  "cli": {
    "mode": "session"
  },
  "actions": [
    {
      "type": "prompt",
      "label": {
        "en": "Add Follow-up",
        "es": "Agregar seguimiento",
        "fr": "Ajouter un suivi",
        "ro": "Adăugați urmărire",
        "it": "Aggiungi follow-up"
      },
      "cli": {
        "mode": "session"
      },
      "prompt": "/opencode run --auto --continue \"$(cat <<'JOAI_PROMPT'\nFor run ID {{RUN_ID}}, continue with this follow-up:\n{{FOLLOWUP}}\nJOAI_PROMPT\n)\"",
      "inputs": [
        {
          "name": "Run ID",
          "as": "RUN_ID",
          "description": {
            "en": "Run identifier to continue.",
            "es": "Identificador de ejecución a continuar.",
            "fr": "Identifiant d'exécution à continuer.",
            "ro": "Identificatorul de rulare de continuat.",
            "it": "Identificatore di esecuzione da continuare."
          },
          "type": "string",
          "source": "field",
          "required": true
        },
        {
          "name": "Follow-up",
          "as": "FOLLOWUP",
          "description": {
            "en": "Additional instruction for OpenCode.",
            "es": "Instrucción adicional para OpenCode.",
            "fr": "Instruction supplémentaire pour OpenCode.",
            "ro": "Instrucțiuni suplimentare pentru OpenCode.",
            "it": "Istruzioni aggiuntive per OpenCode."
          },
          "type": "string",
          "source": "field",
          "required": true
        }
      ]
    }
  ],
  "output": {
    "RUN_ID": "in.RUN_ID",
    "RUN_STATUS": "transform:() => 'submitted'",
    "SUMMARY": "transform:() => 'Follow-up submitted to OpenCode CLI.'"
  },
  "messages": {
    "success": {
      "en": "Follow-up submitted for {{RUN_ID}}.",
      "es": "Seguimiento enviado para {{RUN_ID}}.",
      "fr": "Suivi soumis pour {{RUN_ID}}.",
      "ro": "Urmărire trimisă pentru {{RUN_ID}}.",
      "it": "Follow-up inviato per {{RUN_ID}}."
    }
  }
}
